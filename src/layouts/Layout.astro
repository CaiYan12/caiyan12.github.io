---
import "@fontsource-variable/jetbrains-mono";
// 思源黑体可变字重（README TODO 13 字体策略：全站正文 --font-body）
import "@fontsource-variable/noto-sans-sc";
import "../styles/global.css";
import "../styles/site-toast.css";
import "../styles/site-modal.css";
// Markdown 扩展组件样式（admonition / spoiler / github-card / mermaid）
import "../styles/markdown-extended.css";
// Font Awesome 4 图标（原主题图标字体，class 名与原站完全一致）
import "../styles/font-awesome.css";
import Pio from "../components/widget/Pio.svelte";
import Sakura from "../components/control/Sakura.astro";
import {
	backgroundConfig,
	myhkwPlayerConfig,
	pioConfig,
	siteConfig,
} from "../config";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	prevUrl?: string;
	nextUrl?: string;
	/** og:type（文章页传 "article"，其余默认 "website"） */
	ogType?: string;
}

const { title, description, image, canonicalUrl, prevUrl, nextUrl, ogType } =
	Astro.props;

const siteTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;
const siteDescription = description ?? siteConfig.subtitle;
const absoluteUrl = (relativeUrl: string) =>
	new URL(relativeUrl, siteConfig.siteURL).toString();
const canonicalHref = absoluteUrl(canonicalUrl ?? Astro.url.pathname);
// og:image / twitter:image 必须输出绝对地址（部分平台不识别相对 URL）
const ogImageUrl = absoluteUrl(image ?? "/images/avatar.webp");

// myhkw 使用非标准的 `key` 脚本属性，使用字符串属性映射保留原始嵌入协议。
const myhkwScriptAttributes: Record<string, string> = {
	id: "myhk",
	key: myhkwPlayerConfig.playerId,
	m: myhkwPlayerConfig.mobile ? "1" : "0",
	lr: myhkwPlayerConfig.position === "left" ? "l" : "r",
	skin: myhkwPlayerConfig.skin,
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<title>{siteTitle}</title>
		<meta name="keywords" content={siteConfig.keywords} />
		<meta name="description" content={siteDescription} />
		<link rel="canonical" href={canonicalHref} />
		{prevUrl && <link rel="prev" href={absoluteUrl(prevUrl)} />}
		{nextUrl && <link rel="next" href={absoluteUrl(nextUrl)} />}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="apple-touch-icon" href="/images/avatar.webp" />
		<link rel="icon" href="/images/avatar.webp" type="image/webp" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="RSS"
			href="/rss.xml"
		/>
		{
			pioConfig.enable && (
				<link rel="stylesheet" href="/pio/static/pio.css" />
			)
		}
		<meta property="og:title" content={siteTitle} />
		<meta data-pagefind-meta="title[content]" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:type" content={ogType ?? "website"} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
	</head>
	<body class="transition-swup-fade">
		<!-- 键盘可访问性：Tab 首焦点跳过导航直达正文（样式见 global.css .skip-link） -->
		<a class="skip-link" href="#main">跳到正文</a>
		<!-- 背景层：随机背景图 + 花纹遮罩（对应 footer.php 的 bg-image） -->
		<img
			class="bg-image"
			data-backgrounds={JSON.stringify(backgroundConfig.images)}
			alt=""
			aria-hidden="true"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="bg-image-pattern"></div>
		{
			/* 导航条液态玻璃的折射滤镜：feImage 的位移贴图与 feDisplacementMap 的 scale
		    由 theme-script.ts 的 initLiquidGlass() 按 #head-nav 实际尺寸生成。
		    滤镜节点常驻在 Swup 容器之外（导航本身也在容器外，切页不换），
		    未挂上贴图前 CSS 走纯 blur 回落（见 global.css 的 [data-liquid-glass] 门）。 */
		}
		<svg
			width="0"
			height="0"
			aria-hidden="true"
			focusable="false"
			style="position:fixed;left:0;top:0;pointer-events:none"
		>
			<defs>
				<filter
					id="lg-nav-filter"
					filterUnits="userSpaceOnUse"
					x="0"
					y="0"
					width="0"
					height="0"
					color-interpolation-filters="sRGB"
				>
					<feImage
						id="lg-nav-map"
						x="0"
						y="0"
						width="0"
						height="0"
						href=""></feImage>
					<feDisplacementMap
						in="SourceGraphic"
						in2="lg-nav-map"
						xChannelSelector="R"
						yChannelSelector="G"
						scale="0"></feDisplacementMap>
				</filter>
			</defs>
		</svg>
		<Sakura />

		<slot />

		{pioConfig.enable && <Pio client:idle />}

		{
			myhkwPlayerConfig.enable && (
				<>
					{/* 明月浩空播放器要求 jQuery 先于播放器脚本加载 */}
					{/* 播放器常驻 swup 容器外、切页后并未被换掉；标记 ignore 阻止
					    ScriptsPlugin 重建这两个 script，否则重跑抛"禁止重复添加"。 */}
					<script
						is:inline
						data-swup-ignore-script=""
						src="https://myhkw.cn/player/js/jquery.min.js"
					/>
					<script
						is:inline
						data-swup-ignore-script=""
						src={`https://myhkw.cn/api/player/${myhkwPlayerConfig.playerId}`}
						{...myhkwScriptAttributes}
					/>
				</>
			)
		}

		<style is:inline>
			/* myhkw 与 Pio 同在左下角：播放器必须覆盖 Pio，避免控制面板被模型遮挡。 */
			#myhkplayer {
				z-index: 900000 !important; /* 原值 10000000000 被钳到 int32 上限，与 skip-link 撞成同一个数 */
			}
		</style>

		<!-- 主题脚本：导航高亮、返回顶部、移动端菜单、双击滚动 -->
		<script>
			import { pagefindReady } from "../utils/theme-script";

			// 全局初始化
			pagefindReady();
		</script>
	</body>
</html>
