---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
// Markdown 扩展组件样式（admonition / spoiler / github-card / mermaid）
import "../styles/markdown-extended.css";
// Font Awesome 4 图标（原主题图标字体，class 名与原站完全一致）
import "../styles/font-awesome.css";
import Pio from "../components/widget/Pio.svelte";
import Sakura from "../components/control/Sakura.astro";
import { backgroundConfig, pioConfig, siteConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import { getCollection } from "astro:content";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;

const siteTitle = title
	? `${title} - ${siteConfig.title}`
	: siteConfig.title;
const siteDescription = description ?? siteConfig.subtitle;

// 站点统计（通过 data 属性传给客户端，避免 inline script 插值）
const allPosts = await getCollection("posts");
const posts = getSortedPosts(allPosts);
const totalViews = posts.reduce((sum, p) => sum + p.data.views, 0);
const totalComments = posts.reduce((sum, p) => sum + p.data.comments, 0);
const totalDays = Math.floor(
	(Date.now() - new Date(siteConfig.foundationTime).getTime()) / 86400000,
);
const siteStats = JSON.stringify({
	totalPosts: posts.length,
	totalViews,
	totalComments,
	totalDays,
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<title>{siteTitle}</title>
		<meta name="keywords" content={siteConfig.keywords} />
		<meta name="description" content={siteDescription} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<link rel="apple-touch-icon" href="/images/avatar.webp" />
		<link rel="icon" href="/images/avatar.webp" type="image/webp" />
		<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
		{pioConfig.enable && <link rel="stylesheet" href="/pio/static/pio.css" />}
		<meta property="og:title" content={siteTitle} />
		<meta data-pagefind-meta="title[content]" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta
			property="og:image"
			content={image ? new URL(image, siteConfig.siteURL) : "/images/avatar.webp"}
		/>
		<meta property="og:type" content="website" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
	</head>
	<body class="transition-swup-fade" data-site-stats={siteStats}>
		<!-- 背景层：随机背景图 + 花纹遮罩（对应 footer.php 的 bg-image） -->
		<img
			class="bg-image"
			data-backgrounds={JSON.stringify(backgroundConfig.images)}
			alt=""
			aria-hidden="true"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="bg-image-pattern"></div>
		<Sakura />

		<slot />

		{pioConfig.enable && <Pio client:idle />}

		<!-- 主题脚本：导航高亮、返回顶部、移动端菜单、双击滚动 -->
		<script>
			import { pagefindReady } from "../utils/theme-script";

			// 全局初始化
			pagefindReady();
		</script>
	</body>
</html>
