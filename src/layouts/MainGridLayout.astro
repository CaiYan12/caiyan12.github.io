---
import Layout from "./Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import SideBar from "../components/layout/SideBar.astro";
import Footer from "../components/layout/Footer.astro";
import MMenu from "../components/layout/MMenu.astro";
import BackToTop from "../components/control/BackToTop.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	prevUrl?: string;
	nextUrl?: string;
	/** og:type（文章页传 "article"） */
	ogType?: string;
	/** 是否显示侧栏 */
	showSidebar?: boolean;
	/** 是否将当前页面正文加入 Pagefind 索引 */
	searchIndex?: boolean;
}

const { showSidebar = true, searchIndex = false } = Astro.props;
---

<Layout
	title={Astro.props.title}
	description={Astro.props.description}
	image={Astro.props.image}
	canonicalUrl={Astro.props.canonicalUrl}
	prevUrl={Astro.props.prevUrl}
	nextUrl={Astro.props.nextUrl}
	ogType={Astro.props.ogType}
>
	<!-- 将页面级 head 内容（如结构化数据）透传给 Layout 的 head slot -->
	<slot name="head" slot="head" />
	<div id="lmhblog">
		<Navbar />

		<div id="wrapper" class="wrapper-box">
			<main id="main" class="transition-swup-fade">
				<div id="container">
					<div id="anitOut"></div>
					<div
						class:list={[
							"main-grid",
							!showSidebar && "main-grid-full",
						]}
					>
						<div
							id="content"
							role="main"
							data-pagefind-body={searchIndex ? true : undefined}
						>
							<slot />
						</div>
						{showSidebar && <SideBar />}
					</div>
				</div>
			</main>

			<div class="clear"></div>
			<BackToTop />
		</div>

		<Footer />
		<MMenu />
		<div id="totop" class="totop" aria-hidden="true">
			<i class="fa">&#61610;</i>
		</div>

		<div class="colorful_loading_frame" id="loading-frame">
			<div class="colorful_loading">
				<i class="rect1"></i>
				<i class="rect2"></i>
				<i class="rect3"></i>
				<i class="rect4"></i>
				<i class="rect5"></i>
			</div>
		</div>
	</div>
</Layout>

<script>
	const frame = document.getElementById("loading-frame");
	const show = () => {
		if (frame) frame.style.display = "block";
	};
	const hide = () => {
		if (frame) frame.style.display = "none";
	};
	document.addEventListener("astro:before-swap", show);
	document.addEventListener("astro:page-load", hide);
</script>
