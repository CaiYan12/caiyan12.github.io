---
/**
 * Nice Books 独立页眉（handoff §3.1 / 原型 style.css §3）
 * sticky + 双线下边框；当前项红色下划线——SSR 按 active prop 判定，
 * swup 切页后由 scripts/shared.ts 的 syncHeaderNav() 重算（页眉在容器外）。
 * 导航色类与 shared.ts 的 NAV_BASE/NAV_ACTIVE/NAV_IDLE 常量共用，勿在标记里另写。
 */
import { NAV_ACTIVE, NAV_BASE, NAV_IDLE } from "../scripts/shared";

interface Props {
	active: "home" | "archive";
}
const { active } = Astro.props;

const links: {
	href: string;
	label: string;
	key: "home" | "archive" | null;
	noSwup?: boolean;
}[] = [
	{ href: "/books/", label: "今日好书", key: "home" },
	{ href: "/books/archive/", label: "书库", key: "archive" },
	{ href: "/", label: "返回主站", key: null, noSwup: true },
];
---

<header
	class="sticky top-0 z-20 border-b-[3px] border-double border-nb-border-strong bg-nb-paper"
>
	<div class="mx-auto max-w-[1080px] px-6 max-[540px]:px-4">
		<div
			class="flex h-[62px] items-center justify-between max-[640px]:h-auto max-[640px]:flex-wrap max-[640px]:gap-2 max-[640px]:py-3"
		>
			<a
				href="/books/"
				class="inline-flex items-baseline gap-2 font-nb-serif text-[20px] font-bold tracking-[0.5px] text-nb-ink no-underline hover:text-nb-ink"
			>
				<span class="text-[15px] text-nb-seal" aria-hidden="true"
					>✦</span
				>Nice Books<span
					class="rounded-[2px] border border-nb-border-strong px-1.5 py-px text-[11px] font-normal tracking-[2px] text-nb-muted"
					>每日好书</span
				>
			</a>
			<nav
				class="flex items-center gap-[22px] max-[640px]:gap-4"
				aria-label="站内导航"
			>
				{
					links.map((link) => (
						<a
							href={link.href}
							class={`${NAV_BASE} ${link.key === active ? NAV_ACTIVE : NAV_IDLE}`}
							aria-current={
								link.key === active ? "page" : undefined
							}
							data-nb-nav={link.key ?? "external"}
							data-no-swup={link.noSwup ? "" : undefined}
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</header>
