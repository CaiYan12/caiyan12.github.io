---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import Giscus from "../../components/comment/Giscus.astro";
import dayjs from "dayjs";
import { getCollection, render } from "astro:content";
import {
	getHotPosts,
	getNeighbors,
	getCover,
} from "../../utils/content-utils";
import { siteConfig } from "../../config";
import QRCode from "qrcode";
import PostToc from "../../components/control/PostToc.astro";
import License from "../../components/misc/License.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts
		.filter((p) => !p.data.draft)
		.map((post) => ({
			params: { slug: post.id },
			props: { post },
		}));
}

const { post } = Astro.props;
const { title, published, updated, category, tags, author, comments, views } = post.data;
const { Content, headings } = await render(post);
const allPosts = await getCollection("posts");
const { prev, next } = getNeighbors(allPosts, post.id);
const hotPosts = getHotPosts(allPosts, 6).filter((p) => p.id !== post.id);
const postUrl = new URL(`/posts/${post.id}/`, siteConfig.siteURL);
const cover = getCover(post);
// 构建期本地生成二维码（替代 api.qrserver.com 外链，避免国内可达性问题）
const qrDataUrl = await QRCode.toDataURL(postUrl.toString(), {
	width: 240,
	margin: 1,
});

const starLevel = (comments: number) => {
	if (comments > 70) return 5;
	if (comments > 50) return 4;
	if (comments > 30) return 3;
	if (comments > 10) return 2;
	return 1;
};
---

<MainGridLayout
	title={title}
	description={post.data.description || post.data.excerpt}
	image={`/og/${post.id}.png`}
	searchIndex={!post.data.private}
>
	<div class="page">
		<figure class="post-cover">
			<img src={cover} alt={title} title={title} loading="eager" />
		</figure>

		<article role="article">
			<header class="post-header">
				<h2>{title.slice(0, 50)}</h2>
			</header>

			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-folder-open-o" aria-hidden="true"></i>
				{category ? (
					<a
						href={`/category/${encodeURIComponent(category)}/`}
						title={`查看${category}下的全部文章`}
					>
						{category}
					</a>
				) : (
					"未分类"
				)}
				&raquo;
				<i class="fa fa-clock-o" aria-hidden="true"></i>
				{dayjs(published).format("YYYY年M月D日")}
				<span class="ml-2">
					<i class="fa fa-eye" aria-hidden="true"></i>
					{views} 围观
					<i class="fa fa-comments ml-2" aria-hidden="true"></i>
					{comments} 吐槽
				</span>

				<ul class="tools">
					<li title="字号" class="size" id="font-size-btn">A</li>
				</ul>
			</address>

			<div class="post-context prose">
				<PostToc headings={headings} />
				<Content />

				{updated && (
					<p class="post-last-updated">
						<i class="fa fa-pencil-square-o" aria-hidden="true"></i>
						最后更新于 {dayjs(updated).format("YYYY年M月D日")}
					</p>
				)}

				<div class="post-lisence">
					<div class="qrimg">
						<a
							href={qrDataUrl}
							target="_blank"
							title="用手机扫描二维码访问"
						>
							<img
								src={qrDataUrl}
								alt={title}
								title="用手机扫描二维码访问"
							/>
						</a>
					</div>
					<div class="post-tags">
						<i class="fa fa-tags" aria-hidden="true"></i>
						本文标签：
						{tags.length > 0 ? (
							tags.map((tag) => (
								<a
									rel="tag"
									href={`/tag/${encodeURIComponent(tag)}/`}
								>
									{tag}
								</a>
							))
						) : (
							<span>这篇文章木有标签</span>
						)}
					</div>
					<License author={author} />
					<br />
					<i class="fa fa-share-alt-square" aria-hidden="true"></i>
					本文链接：
					<a href={postUrl.toString()}>{title}</a>
				</div>

				<div class="cutline">
					<span>正文到此结束</span>
				</div>

				<div class="post-navigation">
					{prev && (
						<a
							rel="prev"
							href={`/posts/${prev.id}/`}
							class="prev"
							title={prev.data.title}
						>
							<span class="icon-wrap"></span>
							<h3>{prev.data.title}</h3>
						</a>
					)}
					{next && (
						<a
							rel="next"
							href={`/posts/${next.id}/`}
							class="next"
							title={next.data.title}
						>
							<span class="icon-wrap"></span>
							<h3>{next.data.title}</h3>
						</a>
					)}
				</div>
			</div>
		</article>

		{/* 热门推荐（对应 echo_log.php 的 post-related） */}
		{hotPosts.length > 0 && (
			<div class="post-related">
				<h3>
					<i class="fa fa-fire" aria-hidden="true"></i> 热门推荐
				</h3>
				<ul>
					{hotPosts.map((p) => (
						<li>
							<div class="thumb">
								<a
									href={`/posts/${p.id}/`}
									title={`查看文章：${p.data.title}`}
								>
									<img
										src={getCover(p)}
										alt={p.data.title}
										loading="lazy"
									/>
								</a>
							</div>
							<div class="title">
								<a
									href={`/posts/${p.id}/`}
									title={`查看文章：${p.data.title}`}
								>
									{p.data.title}
								</a>
							</div>
							<div class="modified">
								热门指数：
								<span
									class="star-rating"
									style={`--level: ${starLevel(p.data.comments)}`}
								></span>
							</div>
						</li>
					))}
				</ul>
				<div class="clear"></div>
				<div class="cutline"></div>
			</div>
		)}

		{/* Giscus 评论（对应 blog_comments + blog_comments_post） */}
		<Giscus />
	</div>
</MainGridLayout>

<script>
	// 字号调节（对应原主题 size() 函数）
	const btn = document.getElementById("font-size-btn");
	if (btn) {
		const sizes = [13, 14, 16, 18];
		let idx = 0;
		btn.addEventListener("click", () => {
			idx = (idx + 1) % sizes.length;
			const content = document.querySelector(
				".post-context",
			) as HTMLElement | null;
			if (content) {
				content.style.fontSize = `${sizes[idx]}px`;
				content.style.lineHeight = "1.9";
			}
		});
	}
</script>
