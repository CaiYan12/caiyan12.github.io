---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import Giscus from "../../components/comment/Giscus.astro";
import dayjs from "dayjs";
import { getCollection, render } from "astro:content";
import {
	getCategoryList,
	getCover,
	getHotPosts,
	getTagList,
	isPublicPost,
} from "../../utils/content-utils";
import { buildSeriesNote, getSeriesNeighbors } from "../../utils/series";
import { siteConfig } from "../../config";
import { getEffectiveComments } from "../../utils/site-stats";
import QRCode from "qrcode";
import PostToc from "../../components/control/PostToc.astro";
import License from "../../components/misc/License.astro";
import { getLqipProps } from "../../utils/lqip-utils";
import ResponsiveImage from "../../components/control/ResponsiveImage.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts
		.filter((p) => !p.data.draft)
		.map((post) => ({
			params: { slug: post.id },
			props: { post },
		}));
}

const { post } = Astro.props;
const { title, published, updated, category, tags, author, readingTime } =
	post.data;
const comments = getEffectiveComments(post);
const { Content, headings } = await render(post);
const allPosts = await getCollection("posts");
// 只对**真的生成出来的路由**发链接（#41）：/tag/<x>/ 与 /category/<x>/ 的 getStaticPaths
// 枚举的是 getTagList(publicPosts)／getCategoryList(publicPosts)，而这两个函数都先过
// isPublicPost——私有文章独占的那一项从不生成页面，链过去就是 404。
// 判据与路由生成端同源，因此逐项退化而不是整行抹掉：私有文章若用的是公开分类（例如
// 「技术」）链接照常保留，只有无路由的那几项降成纯文字。
const publicPosts = allPosts.filter(isPublicPost);
const routedTags = new Set(getTagList(publicPosts).map(({ name }) => name));
const routedCategories = new Set(
	getCategoryList(publicPosts).map(({ name }) => name),
);
const { prev, next, series } = getSeriesNeighbors(allPosts, post.id);
// 归属两行只在成员文章页渲染（非成员 series === null）；末章 = 组内没有下一篇，末尾行改收尾文案
const seriesNote = series ? buildSeriesNote(series, next === null) : null;
const hotPosts = getHotPosts(allPosts, 6).filter((p) => p.id !== post.id);
const postUrl = new URL(`/posts/${post.id}/`, siteConfig.siteURL);
const cover = getCover(post);
// 构建期本地生成二维码（替代 api.qrserver.com 外链，避免国内可达性问题）
const qrDataUrl = await QRCode.toDataURL(postUrl.toString(), {
	width: 240,
	margin: 1,
});

// BlogPosting 结构化数据（SEO）：字段复用页面既有变量
const ogImageUrl = new URL(`/og/${post.id}.png`, siteConfig.siteURL).toString();
const postDescription = post.data.description || post.data.excerpt;
const blogPostingJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	image: ogImageUrl,
	datePublished: published.toISOString(),
	dateModified: (updated ?? published).toISOString(),
	mainEntityOfPage: postUrl.toString(),
	author: {
		"@type": "Person",
		name: author,
		url: new URL("/about/", siteConfig.siteURL).toString(),
	},
	...(postDescription ? { description: postDescription } : {}),
};

const starLevel = (comments: number) => {
	if (comments > 70) return 5;
	if (comments > 50) return 4;
	if (comments > 30) return 3;
	if (comments > 10) return 2;
	return 1;
};
---

<MainGridLayout
	title={title}
	description={post.data.description || post.data.excerpt}
	image={`/og/${post.id}.png`}
	ogType="article"
	searchIndex={!post.data.private}
>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(blogPostingJsonLd).replace(/</g, "\\u003c")}
		slot="head"
	/>
	<div class="page">
		<div
			class="post-reading-progress"
			data-reading-progress
			role="progressbar"
			aria-label="文章阅读进度"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
		>
		</div>
		<figure class="post-cover lqip-wrap">
			<div
				class="lqip-placeholder"
				style={getLqipProps(cover).style}
				aria-hidden="true"
			>
			</div>
			<ResponsiveImage
				src={cover}
				alt={title}
				title={title}
				loading="eager"
				sizes="(max-width: 680px) 100vw, (max-width: 1000px) calc(100vw - 40px), 660px"
			/>
		</figure>

		<article role="article">
			<header class="post-header">
				<h1 title={title}>{title}</h1>
			</header>

			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-folder-open-o" aria-hidden="true"></i>
				{
					category ? (
						routedCategories.has(category) ? (
							<a
								href={`/category/${encodeURIComponent(category)}/`}
								title={`查看${category}下的全部文章`}
							>
								{category}
							</a>
						) : (
							<span>{category}</span>
						)
					) : (
						"未分类"
					)
				}
				&raquo;
				<i class="fa fa-clock-o" aria-hidden="true"></i>
				{dayjs(published).format("YYYY年M月D日")}
				<span class="ml-2">
					<i class="fa fa-comments ml-2" aria-hidden="true"></i>
					{comments} 吐槽
				</span>
				{
					typeof readingTime === "number" && (
						<span class="ml-2">
							<i class="fa fa-search ml-2" aria-hidden="true" />
							{readingTime} 分钟读完
						</span>
					)
				}

				<ul class="tools">
					<li title="字号" class="size" id="font-size-btn">
						A
						<div class="font-size-pop" id="font-size-pop">
							<input
								type="range"
								id="font-size-range"
								min="12"
								max="24"
								step="1"
								value="14"
								aria-label="正文字号"
							/>
							<output id="font-size-value" for="font-size-range"
								>14px</output
							>
						</div>
					</li>
				</ul>
			</address>

			{
				seriesNote && (
					<p class="post-series">
						{seriesNote.top.prefix} ·{" "}
						<a href={seriesNote.top.link.href}>
							{seriesNote.top.link.label}
						</a>
					</p>
				)
			}

			<div class="post-context prose post-body">
				<PostToc headings={headings} />
				<Content />

				{
					updated && (
						<p class="post-last-updated">
							<i
								class="fa fa-pencil-square-o"
								aria-hidden="true"
							/>
							最后更新于 {dayjs(updated).format("YYYY年M月D日")}
						</p>
					)
				}

				<div class="post-lisence">
					<div class="qrimg">
						<a
							href={qrDataUrl}
							data-fancybox="qr-code"
							data-caption={title}
							title="用手机扫描二维码访问"
						>
							<img
								src={qrDataUrl}
								alt={title}
								title="用手机扫描二维码访问"
							/>
						</a>
					</div>
					<div class="post-tags">
						<i class="fa fa-tags" aria-hidden="true"></i>
						本文标签：
						{
							tags.length > 0 ? (
								tags.map((tag) =>
									routedTags.has(tag) ? (
										<a
											rel="tag"
											href={`/tag/${encodeURIComponent(tag)}/`}
										>
											{tag}
										</a>
									) : (
										<span>{tag}</span>
									),
								)
							) : (
								<span>这篇文章木有标签</span>
							)
						}
					</div>
					<License author={author} />
					<br />
					<i class="fa fa-share-alt-square" aria-hidden="true"></i>
					本文链接：
					<a
						href={postUrl.toString()}
						class="copy-post-link"
						data-copy-link={postUrl.toString()}
						title="点击复制本文链接"
						aria-label={`复制本文链接：${title}`}
					>
						{title}
					</a>
				</div>

				<div class="cutline">
					<span>正文到此结束</span>
				</div>

				{
					seriesNote && (
						<p class="post-series">
							{seriesNote.bottom.prefix}
							{seriesNote.bottom.link && (
								<>
									{" "}
									·{" "}
									<a href={seriesNote.bottom.link.href}>
										{seriesNote.bottom.link.label}
									</a>
								</>
							)}
						</p>
					)
				}

				<div class="post-navigation">
					{
						prev && (
							<a
								rel="prev"
								href={`/posts/${prev.id}/`}
								class="prev"
								title={prev.data.title}
							>
								<span class="icon-wrap" />
								<h3>
									<span class="post-navigation-title">
										{prev.data.title}
									</span>
								</h3>
							</a>
						)
					}
					{
						next && (
							<a
								rel="next"
								href={`/posts/${next.id}/`}
								class="next"
								title={next.data.title}
							>
								<span class="icon-wrap" />
								<h3>
									<span class="post-navigation-title">
										{next.data.title}
									</span>
								</h3>
							</a>
						)
					}
				</div>
			</div>
		</article>

		{/* 热门推荐（对应 echo_log.php 的 post-related） */}
		{
			hotPosts.length > 0 && (
				<div class="post-related">
					<h3>
						<i class="fa fa-fire" aria-hidden="true" /> 热门推荐
					</h3>
					<ul>
						{hotPosts.map((p) => (
							<li>
								<div class="thumb">
									<a
										href={`/posts/${p.id}/`}
										title={`查看文章：${p.data.title}`}
									>
										<img
											src={getCover(p)}
											alt={p.data.title}
											loading="lazy"
										/>
									</a>
								</div>
								<div class="title">
									<a
										href={`/posts/${p.id}/`}
										title={`查看文章：${p.data.title}`}
									>
										{p.data.title}
									</a>
								</div>
								<div class="modified">
									热门指数：
									<span
										class="star-rating"
										style={`--level: ${starLevel(getEffectiveComments(p))}`}
									/>
								</div>
							</li>
						))}
					</ul>
					<div class="clear" />
					<div class="cutline" />
				</div>
			)
		}

		{/* Giscus 评论（对应 blog_comments + blog_comments_post） */}
		<Giscus />
	</div>
</MainGridLayout>
