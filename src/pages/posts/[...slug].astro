---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import Giscus from "../../components/comment/Giscus.astro";
import dayjs from "dayjs";
import { getCollection, render } from "astro:content";
import { getHotPosts, getNeighbors, getCover } from "../../utils/content-utils";
import { siteConfig } from "../../config";
import { getEffectiveComments } from "../../utils/site-stats";
import QRCode from "qrcode";
import PostToc from "../../components/control/PostToc.astro";
import License from "../../components/misc/License.astro";
import { getLqipProps } from "../../utils/lqip-utils";
import ResponsiveImage from "../../components/control/ResponsiveImage.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts
		.filter((p) => !p.data.draft)
		.map((post) => ({
			params: { slug: post.id },
			props: { post },
		}));
}

const { post } = Astro.props;
const { title, published, updated, category, tags, author } = post.data;
const comments = getEffectiveComments(post);
const { Content, headings } = await render(post);
const allPosts = await getCollection("posts");
const { prev, next } = getNeighbors(allPosts, post.id);
const hotPosts = getHotPosts(allPosts, 6).filter((p) => p.id !== post.id);
const postUrl = new URL(`/posts/${post.id}/`, siteConfig.siteURL);
const cover = getCover(post);
// 构建期本地生成二维码（替代 api.qrserver.com 外链，避免国内可达性问题）
const qrDataUrl = await QRCode.toDataURL(postUrl.toString(), {
	width: 240,
	margin: 1,
});

// BlogPosting 结构化数据（SEO）：字段复用页面既有变量
const ogImageUrl = new URL(`/og/${post.id}.png`, siteConfig.siteURL).toString();
const postDescription = post.data.description || post.data.excerpt;
const blogPostingJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	image: ogImageUrl,
	datePublished: published.toISOString(),
	dateModified: (updated ?? published).toISOString(),
	mainEntityOfPage: postUrl.toString(),
	author: {
		"@type": "Person",
		name: author,
		url: new URL("/about/", siteConfig.siteURL).toString(),
	},
	...(postDescription ? { description: postDescription } : {}),
};

const starLevel = (comments: number) => {
	if (comments > 70) return 5;
	if (comments > 50) return 4;
	if (comments > 30) return 3;
	if (comments > 10) return 2;
	return 1;
};
---

<MainGridLayout
	title={title}
	description={post.data.description || post.data.excerpt}
	image={`/og/${post.id}.png`}
	ogType="article"
	searchIndex={!post.data.private}
>
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(blogPostingJsonLd).replace(/</g, "\\u003c")}
		slot="head"
	/>
	<div class="page">
		<figure class="post-cover lqip-wrap">
			<div
				class="lqip-placeholder"
				style={getLqipProps(cover).style}
				aria-hidden="true"
			>
			</div>
			<ResponsiveImage
				src={cover}
				alt={title}
				title={title}
				loading="eager"
				sizes="(max-width: 680px) 100vw, (max-width: 1000px) calc(100vw - 40px), 660px"
			/>
		</figure>

		<article role="article">
			<header class="post-header">
				<h1>{title}</h1>
			</header>

			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-folder-open-o" aria-hidden="true"></i>
				{
					category ? (
						<a
							href={`/category/${encodeURIComponent(category)}/`}
							title={`查看${category}下的全部文章`}
						>
							{category}
						</a>
					) : (
						"未分类"
					)
				}
				&raquo;
				<i class="fa fa-clock-o" aria-hidden="true"></i>
				{dayjs(published).format("YYYY年M月D日")}
				<span class="ml-2">
					<i class="fa fa-comments ml-2" aria-hidden="true"></i>
					{comments} 吐槽
				</span>

				<ul class="tools">
					<li title="字号" class="size" id="font-size-btn">
						A
						<div class="font-size-pop" id="font-size-pop">
							<input
								type="range"
								id="font-size-range"
								min="12"
								max="24"
								step="1"
								value="14"
								aria-label="正文字号"
							/>
							<output id="font-size-value" for="font-size-range"
								>14px</output
							>
						</div>
					</li>
				</ul>
			</address>

			<div class="post-context prose">
				<PostToc headings={headings} />
				<Content />

				{
					updated && (
						<p class="post-last-updated">
							<i
								class="fa fa-pencil-square-o"
								aria-hidden="true"
							/>
							最后更新于 {dayjs(updated).format("YYYY年M月D日")}
						</p>
					)
				}

				<div class="post-lisence">
					<div class="qrimg">
						<a
							href={qrDataUrl}
							data-fancybox="qr-code"
							data-caption={title}
							title="用手机扫描二维码访问"
						>
							<img
								src={qrDataUrl}
								alt={title}
								title="用手机扫描二维码访问"
							/>
						</a>
					</div>
					<div class="post-tags">
						<i class="fa fa-tags" aria-hidden="true"></i>
						本文标签：
						{
							tags.length > 0 ? (
								tags.map((tag) => (
									<a
										rel="tag"
										href={`/tag/${encodeURIComponent(tag)}/`}
									>
										{tag}
									</a>
								))
							) : (
								<span>这篇文章木有标签</span>
							)
						}
					</div>
					<License author={author} />
					<br />
					<i class="fa fa-share-alt-square" aria-hidden="true"></i>
					本文链接：
					<a
						href={postUrl.toString()}
						class="copy-post-link"
						data-copy-link={postUrl.toString()}
						title="点击复制本文链接"
						aria-label={`复制本文链接：${title}`}
					>
						{title}
					</a>
				</div>

				<div class="cutline">
					<span>正文到此结束</span>
				</div>

				<div class="post-navigation">
					{
						prev && (
							<a
								rel="prev"
								href={`/posts/${prev.id}/`}
								class="prev"
								title={prev.data.title}
							>
								<span class="icon-wrap" />
								<h3>
									<span class="post-navigation-title">
										{prev.data.title}
									</span>
								</h3>
							</a>
						)
					}
					{
						next && (
							<a
								rel="next"
								href={`/posts/${next.id}/`}
								class="next"
								title={next.data.title}
							>
								<span class="icon-wrap" />
								<h3>
									<span class="post-navigation-title">
										{next.data.title}
									</span>
								</h3>
							</a>
						)
					}
				</div>
			</div>
		</article>

		{/* 热门推荐（对应 echo_log.php 的 post-related） */}
		{
			hotPosts.length > 0 && (
				<div class="post-related">
					<h3>
						<i class="fa fa-fire" aria-hidden="true" /> 热门推荐
					</h3>
					<ul>
						{hotPosts.map((p) => (
							<li>
								<div class="thumb">
									<a
										href={`/posts/${p.id}/`}
										title={`查看文章：${p.data.title}`}
									>
										<img
											src={getCover(p)}
											alt={p.data.title}
											loading="lazy"
										/>
									</a>
								</div>
								<div class="title">
									<a
										href={`/posts/${p.id}/`}
										title={`查看文章：${p.data.title}`}
									>
										{p.data.title}
									</a>
								</div>
								<div class="modified">
									热门指数：
									<span
										class="star-rating"
										style={`--level: ${starLevel(getEffectiveComments(p))}`}
									/>
								</div>
							</li>
						))}
					</ul>
					<div class="clear" />
					<div class="cutline" />
				</div>
			)
		}

		{/* Giscus 评论（对应 blog_comments + blog_comments_post） */}
		<Giscus />
	</div>

	<script>
		// 字号调节（对应原主题 size() 函数）。脚本必须位于 swup 容器（main）内：
		// 容器外的模块脚本整页生命周期只执行一次，swup 换页后新按钮无监听（实测踩坑）。
		// 协议：顶层 init + colorful:page:loaded 重跑 + dataset 守卫防重复（同 Slideshow）。
		const FONT_SIZE_KEY = "postFontSize";
		const FONT_SIZE_MIN = 12;
		const FONT_SIZE_MAX = 24;

		function applyPostFontSize(px: number): void {
			const content = document.querySelector(
				".post-context",
			) as HTMLElement | null;
			if (content) {
				content.style.fontSize = `${px}px`;
				content.style.lineHeight = "1.9";
			}
		}

		function initFontSizeToggle(): void {
			const btn = document.getElementById("font-size-btn");
			const pop = document.getElementById("font-size-pop");
			const range = document.getElementById(
				"font-size-range",
			) as HTMLInputElement | null;
			const output = document.getElementById("font-size-value");
			if (!btn || !pop || !range || !output) return;
			if (btn.dataset.fontSizeInit === "true") return;
			btn.dataset.fontSizeInit = "true";

			// 恢复持久化字号：仅在用户调整过（存在存储值）时应用，默认档不写内联样式
			const raw = localStorage.getItem(FONT_SIZE_KEY);
			if (raw !== null) {
				const saved = Number.parseInt(raw, 10);
				if (saved >= FONT_SIZE_MIN && saved <= FONT_SIZE_MAX) {
					applyPostFontSize(saved);
					range.value = String(saved);
					output.textContent = `${saved}px`;
				}
			}

			// Flutter 式轨道填充：--p（0..1）驱动渐变端点对齐拇指圆心
			const updateRangeFill = (): void => {
				const p =
					(Number.parseInt(range.value, 10) - FONT_SIZE_MIN) /
					(FONT_SIZE_MAX - FONT_SIZE_MIN);
				range.style.setProperty("--p", String(p));
			};
			updateRangeFill();

			const setOpen = (open: boolean): void => {
				btn.classList.toggle("active", open);
				pop.classList.toggle("active", open);
			};

			btn.addEventListener("click", (event) => {
				// 弹层（滑块）内的点击冒泡到按钮时不折叠
				if ((event.target as HTMLElement).closest(".font-size-pop"))
					return;
				setOpen(!pop.classList.contains("active"));
			});
			range.addEventListener("pointerdown", () => {
				// 拖动开始前清掉页面残留选区：旧选区会随拖动一起被拖着走，
				// 在气泡内外留下 "A"/"xxpx" 的拖影
				getSelection()?.removeAllRanges();
			});
			range.addEventListener("input", () => {
				const px = Number.parseInt(range.value, 10);
				output.textContent = `${px}px`;
				applyPostFontSize(px);
				updateRangeFill();
				localStorage.setItem(FONT_SIZE_KEY, String(px));
			});
		}
		initFontSizeToggle();
		document.addEventListener("colorful:page:loaded", initFontSizeToggle);

		// 点击按钮与弹层之外的区域收起弹层。用 pointerdown 而非 click：从拇指拖出
		// 弹层松手时 click 的 target 会落在弹层外造成误关；window 旗标防生产内联
		// 模块被 swup 克隆重执行时重复注册（同 TagCloud3D 注册表思路）
		const w = window as unknown as { __fontSizeClickAwayBound?: true };
		if (!w.__fontSizeClickAwayBound) {
			w.__fontSizeClickAwayBound = true;
			document.addEventListener("pointerdown", (event) => {
				if (event.button !== 0) return;
				const btn = document.getElementById("font-size-btn");
				const pop = document.getElementById("font-size-pop");
				if (!btn || !pop || !pop.classList.contains("active")) return;
				const target = event.target as Node;
				if (btn.contains(target) || pop.contains(target)) return;
				btn.classList.remove("active");
				pop.classList.remove("active");
			});
		}
	</script>
</MainGridLayout>
