---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getCover, isPublicPost } from "../utils/content-utils";
import ResponsiveImage from "../components/control/ResponsiveImage.astro";
import dayjs from "dayjs";

const allPosts = await getCollection("posts");
// 图片墙：展示所有文章的封面图（对应 page-images.php 的 imageswall 网格）
const wallImages = allPosts
	.filter(isPublicPost)
	.slice(0, 40)
	.map((post) => ({
		title: post.data.title,
		url: `/posts/${post.id}/`,
		image: getCover(post),
		published: post.data.published,
	}));
---

<MainGridLayout title="图片墙" description="文章封面图片墙" showSidebar={false}>
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h1>
					<i class="fa fa-picture-o" aria-hidden="true"></i> 图片墙
				</h1>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-picture-o" aria-hidden="true"></i>
				图片墙
			</address>

			<div class="imageswall">
				<div class="grid">
					{
						wallImages.map((item) => (
							<a
								class="image-card"
								href={item.url}
								title={item.title}
							>
								<span class="imgtext">{item.title}</span>
								<ResponsiveImage
									src={item.image}
									alt={item.title}
									loading="lazy"
									sizes="(max-width: 680px) 33vw, 240px"
								/>
								<span class="meta">
									<i
										class="fa fa-calendar"
										aria-hidden="true"
									/>
									{dayjs(item.published).format(
										"YYYY年MM月DD日",
									)}
								</span>
							</a>
						))
					}
				</div>
			</div>
		</article>
	</div>
</MainGridLayout>
