---
import MainGridLayout from "../../../../../layouts/MainGridLayout.astro";
import PostCard from "../../../../../components/layout/PostCard.astro";
import Pagination from "../../../../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getSortedPosts, isPublicPost } from "../../../../../utils/content-utils";
import { getPaginationUrl } from "../../../../../utils/pagination";
import dayjs from "dayjs";
import { siteConfig } from "../../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("posts");
	const sortedPosts = getSortedPosts(allPosts.filter(isPublicPost));
	const months = [
		...new Set(sortedPosts.map((post) => dayjs(post.data.published).format("YYYY-M"))),
	];
	return months.flatMap((month) => {
		const [year, monthNumber] = month.split("-");
		const posts = sortedPosts.filter(
			(post) => dayjs(post.data.published).format("YYYY-M") === month,
		);
		return paginate(posts, {
			params: { year, month: monthNumber },
			pageSize: siteConfig.postsPerPage,
		});
	});
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const year = Astro.params.year;
const month = Astro.params.month;
const label = `${year}年${Number(month)}月`;
const rootUrl = `/archive/${year}/${month}/`;
const current = page.currentPage;
const total = page.lastPage;
---

<MainGridLayout
	title={`归档：${label}`}
	description={`${label} 的文章归档`}
	canonicalUrl={getPaginationUrl(rootUrl, current)}
	prevUrl={current > 1 ? getPaginationUrl(rootUrl, current - 1) : undefined}
	nextUrl={current < total ? getPaginationUrl(rootUrl, current + 1) : undefined}
>
	<div class="page">
		<header class="post-header">
			<h2>
				<i class="fa fa-archive" aria-hidden="true"></i>
				归档：{label}
				<span class="ml-2 text-sm font-normal text-gray-500">
					共 {page.total} 篇文章
				</span>
			</h2>
		</header>
	</div>

	{page.data.map((post) => <PostCard post={post} />)}

	<Pagination
		current={current}
		total={total}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
