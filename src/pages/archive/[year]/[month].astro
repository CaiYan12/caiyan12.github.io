---
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import PostCard from "../../../components/layout/PostCard.astro";
import Pagination from "../../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import { getSortedPosts, isPublicPost } from "../../../utils/content-utils";
import { getPaginationUrl } from "../../../utils/pagination";
import dayjs from "dayjs";
import { siteConfig } from "../../../config";

export async function getStaticPaths() {
	const allPosts = await getCollection("posts");
	const sortedPosts = getSortedPosts(allPosts.filter(isPublicPost));
	const months = [
		...new Set(
			sortedPosts.map((post) =>
				dayjs(post.data.published).format("YYYY-M"),
			),
		),
	];
	return months.map((month) => {
		const [year, monthNumber] = month.split("-");
		const posts = sortedPosts.filter(
			(post) => dayjs(post.data.published).format("YYYY-M") === month,
		);
		return {
			params: { year, month: monthNumber },
			props: {
				label: `${year}年${Number(monthNumber)}月`,
				posts,
			},
		};
	});
}

const { label, posts } = Astro.props;
const year = Astro.params.year;
const month = Astro.params.month;
const rootUrl = `/archive/${year}/${month}/`;
const pages = Math.max(1, Math.ceil(posts.length / siteConfig.postsPerPage));
const pagePosts = posts.slice(0, siteConfig.postsPerPage);
---

<MainGridLayout
	title={`归档：${label}`}
	description={`${label} 的文章归档`}
	canonicalUrl={rootUrl}
	nextUrl={pages > 1 ? getPaginationUrl(rootUrl, 2) : undefined}
>
	<div class="page">
		<header class="post-header">
			<h2>
				<i class="fa fa-archive" aria-hidden="true"></i>
				归档：{label}
				<span class="ml-2 text-sm font-normal text-gray-500">
					共 {posts.length} 篇文章
				</span>
			</h2>
		</header>
	</div>

	{pagePosts.map((post) => <PostCard post={post} />)}

	<Pagination
		current={1}
		total={pages}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
