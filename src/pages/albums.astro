---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { scanAlbums } from "../utils/album-scanner";

const albums = scanAlbums();
---

<MainGridLayout title="相册图库" description="WindowsIt 的相册图库">
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h2>
					<i class="fa fa-camera-retro" aria-hidden="true"></i> 相册图库
				</h2>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-camera-retro" aria-hidden="true"></i>
				相册图库
			</address>

			{albums.length > 0 ? (
				<div class="album-grid">
					{albums.map((album) => (
						<a
							href={`/albums/${album.slug}/`}
							class="album-card"
							title={`查看相册：${album.name}`}
						>
							<img src={album.cover} alt={album.name} loading="lazy" />
							<span class="album-name">
								<i class="fa fa-picture-o" aria-hidden="true"></i>
								{album.name}
							</span>
							<span class="album-count">{album.photos.length} 张</span>
						</a>
					))}
				</div>
			) : (
				<div class="post-context">
					<p>
						还没有相册。在 <code>public/images/albums/</code>{" "}
						下新建文件夹（每张图片即一张照片），即可生成相册。
					</p>
				</div>
			)}
		</article>
	</div>
</MainGridLayout>
