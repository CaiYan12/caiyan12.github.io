---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import Search from "../components/control/Search.svelte";
---

<MainGridLayout title="站内搜索" description="搜索本站内容">
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h1>
					<i class="fa fa-search" aria-hidden="true"></i> 站内搜索
				</h1>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-search" aria-hidden="true"></i>
				站内搜索
			</address>

			<div class="post-context">
				<Search client:only="svelte">
					<div slot="fallback">
						<p>
							站内搜索需要浏览器启用
							JavaScript：检索索引在构建期生成，由浏览器在本地匹配。
						</p>
						<p>
							也可以先从这些地方找内容：
							<a href="/tag/">标签云集</a>
							·
							<a href="/category/">文章分类</a>
							·
							<a href="/archive/">全部文章</a>
						</p>
					</div>
				</Search>
			</div>
		</article>
	</div>
</MainGridLayout>
