---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import PostCard from "../../components/layout/PostCard.astro";
import Pagination from "../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import { getSortedPosts, getTagList, isPublicPost } from "../../utils/content-utils";
import { getPaginationUrl } from "../../utils/pagination";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
	const allPosts = await getCollection("posts");
	const publicPosts = allPosts.filter(isPublicPost);
	const sortedPosts = getSortedPosts(publicPosts);
	const tags = getTagList(publicPosts);
	return tags.map(({ name }) => {
		const posts = sortedPosts.filter((post) => post.data.tags.includes(name));
		return {
			params: { tag: name },
			props: { name, posts, tags },
		};
	});
}

const { name, posts, tags } = Astro.props;
const rootUrl = `/tag/${encodeURIComponent(name)}/`;
const pageSize = siteConfig.tagPostsPerPage;
const pages = Math.max(1, Math.ceil(posts.length / pageSize));
const pagePosts = posts.slice(0, pageSize);
---

<MainGridLayout
	title={`标签：${name}`}
	description={`标签 ${name} 下的全部文章`}
	canonicalUrl={rootUrl}
	nextUrl={pages > 1 ? getPaginationUrl(rootUrl, 2) : undefined}
>
	<div class="page tag-page">
		<header class="post-header">
			<h2>
				<i class="fa fa-tags" aria-hidden="true"></i>
				标签：{name}
			</h2>
		</header>
		<address class="post-metaa">
			<i class="fa fa-home" aria-hidden="true"></i>
			<a href="/" title="返回首页">首页</a>
			&raquo;
			<a href="/tag/" title="返回标签云集">标签云集</a>
			&raquo;
			<i class="fa fa-tag" aria-hidden="true"></i>
			{name}
		</address>

		<div class="post-context">
			<p>共 {posts.length} 篇文章</p>
		</div>

		<ul id="blogtags">
			<li class="tag-cloud-items">
				{tags.map((tag) => (
					<a
						href={`/tag/${encodeURIComponent(tag.name)}/`}
						title={`${tag.count}篇文章`}
						aria-current={tag.name === name ? "page" : undefined}
						class:list={[{ "is-current": tag.name === name }]}
					>
						{tag.name}<span class="tag-count">&times;{tag.count}</span>
					</a>
				))}
			</li>
		</ul>
	</div>

	{pagePosts.map((post) => <PostCard post={post} />)}

	<Pagination
		current={1}
		total={pages}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
