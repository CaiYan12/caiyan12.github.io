---
import MainGridLayout from "../../../../layouts/MainGridLayout.astro";
import PostCard from "../../../../components/layout/PostCard.astro";
import Pagination from "../../../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getSortedPosts, getTagList, isPublicPost } from "../../../../utils/content-utils";
import { getPaginationUrl } from "../../../../utils/pagination";
import { siteConfig } from "../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("posts");
	const publicPosts = allPosts.filter(isPublicPost);
	const sortedPosts = getSortedPosts(publicPosts);
	const tags = getTagList(publicPosts);
	return tags.flatMap(({ name }) =>
		paginate(
			sortedPosts.filter((post) => post.data.tags.includes(name)),
			{
				params: { tag: name },
				props: { tags },
				pageSize: siteConfig.tagPostsPerPage,
			},
		),
	);
}) satisfies GetStaticPaths;

const { page, tags } = Astro.props;
const name = Astro.params.tag;
const rootUrl = `/tag/${encodeURIComponent(name)}/`;
const current = page.currentPage;
const total = page.lastPage;
---

<MainGridLayout
	title={`标签：${name}`}
	description={`标签 ${name} 下的全部文章`}
	canonicalUrl={getPaginationUrl(rootUrl, current)}
	prevUrl={current > 1 ? getPaginationUrl(rootUrl, current - 1) : undefined}
	nextUrl={current < total ? getPaginationUrl(rootUrl, current + 1) : undefined}
>
	<div class="page tag-page">
		<header class="post-header">
			<h2>
				<i class="fa fa-tags" aria-hidden="true"></i>
				标签：{name}
			</h2>
		</header>
		<address class="post-metaa">
			<i class="fa fa-home" aria-hidden="true"></i>
			<a href="/" title="返回首页">首页</a>
			&raquo;
			<a href="/tag/" title="返回标签云集">标签云集</a>
			&raquo;
			<i class="fa fa-tag" aria-hidden="true"></i>
			{name}
		</address>

		<div class="post-context">
			<p>共 {page.total} 篇文章</p>
		</div>

		<ul id="blogtags">
			<li class="tag-cloud-items">
				{tags.map((tag) => (
					<a
						href={`/tag/${encodeURIComponent(tag.name)}/`}
						title={`${tag.count}篇文章`}
						aria-current={tag.name === name ? "page" : undefined}
						class:list={[{ "is-current": tag.name === name }]}
					>
						{tag.name}<span class="tag-count">&times;{tag.count}</span>
					</a>
				))}
			</li>
		</ul>
	</div>

	{page.data.map((post) => <PostCard post={post} />)}

	<Pagination
		current={current}
		total={total}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
