---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import PostCard from "../../components/layout/PostCard.astro";
import Pagination from "../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import { getSortedPosts, getTagList } from "../../utils/content-utils";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
	const allPosts = await getCollection("posts");
	const tags = getTagList(allPosts);
	const paths: {
		params: { tag: string; page: string | undefined };
		props: { name: string; posts: typeof allPosts; current: number; pages: number };
	}[] = [];
	for (const tag of tags) {
		const posts = getSortedPosts(allPosts).filter(
			(p) => !p.data.draft && p.data.tags.includes(tag.name),
		);
		const pages = Math.max(1, Math.ceil(posts.length / siteConfig.postsPerPage));
		for (let i = 1; i <= pages; i++) {
			paths.push({
				params: { tag: tag.name, page: i === 1 ? undefined : `page/${i}` },
				props: {
					name: tag.name,
					posts: posts.slice((i - 1) * siteConfig.postsPerPage, i * siteConfig.postsPerPage),
					current: i,
					pages,
				},
			});
		}
	}
	return paths;
}

const { name, posts, current, pages } = Astro.props;
---

<MainGridLayout title={`标签：${name}`} description={`标签 ${name} 下的全部文章`}>
	<div class="page">
		<header class="post-header">
			<h2>
				<i class="fa fa-tags" aria-hidden="true"></i>
				标签：{name}
				<span class="ml-2 text-sm font-normal text-gray-500">
					共 {posts.length} 篇文章
				</span>
			</h2>
		</header>
	</div>

	{posts.map((post) => (
		<PostCard post={post} />
	))}

	<Pagination current={current} total={pages} urlTemplate={`/tag/${encodeURIComponent(name)}/page/{n}/`} />
</MainGridLayout>
