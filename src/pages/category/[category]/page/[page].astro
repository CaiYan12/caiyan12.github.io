---
import MainGridLayout from "../../../../layouts/MainGridLayout.astro";
import PostCard from "../../../../components/layout/PostCard.astro";
import Pagination from "../../../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getCategoryList, getSortedPosts, isPublicPost } from "../../../../utils/content-utils";
import { getPaginationUrl } from "../../../../utils/pagination";
import { siteConfig } from "../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("posts");
	const publicPosts = allPosts.filter(isPublicPost);
	const sortedPosts = getSortedPosts(publicPosts);
	return getCategoryList(publicPosts).flatMap(({ name }) =>
		paginate(
			sortedPosts.filter((post) => post.data.category === name),
			{
				params: { category: name },
				pageSize: siteConfig.postsPerPage,
			},
		),
	);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const name = Astro.params.category;
const rootUrl = `/category/${encodeURIComponent(name)}/`;
const current = page.currentPage;
const total = page.lastPage;
---

<MainGridLayout
	title={`分类：${name}`}
	description={`分类 ${name} 下的全部文章`}
	canonicalUrl={getPaginationUrl(rootUrl, current)}
	prevUrl={current > 1 ? getPaginationUrl(rootUrl, current - 1) : undefined}
	nextUrl={current < total ? getPaginationUrl(rootUrl, current + 1) : undefined}
>
	<div class="page">
		<header class="post-header">
			<h2>
				<i class="fa fa-folder-open-o" aria-hidden="true"></i>
				分类：{name}
				<span class="ml-2 text-sm font-normal text-gray-500">
					共 {page.total} 篇文章
				</span>
			</h2>
		</header>
	</div>

	{page.data.map((post) => <PostCard post={post} />)}

	<Pagination
		current={current}
		total={total}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
