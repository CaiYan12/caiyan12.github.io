---
import MainGridLayout from "../../../../layouts/MainGridLayout.astro";
import PostCard from "../../../../components/layout/PostCard.astro";
import Pagination from "../../../../components/layout/Pagination.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import {
	getCategoryList,
	getSortedPosts,
	isPublicPost,
} from "../../../../utils/content-utils";
import { getPaginationUrl } from "../../../../utils/pagination";
import { siteConfig } from "../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("posts");
	const publicPosts = allPosts.filter(isPublicPost);
	const sortedPosts = getSortedPosts(publicPosts);
	const categories = getCategoryList(publicPosts);
	return categories.flatMap(({ name }) =>
		paginate(
			sortedPosts.filter((post) => post.data.category === name),
			{
				params: { category: name },
				props: { categories },
				pageSize: siteConfig.postsPerPage,
			},
		),
	);
}) satisfies GetStaticPaths;

const { page, categories } = Astro.props;
const name = Astro.params.category;
const rootUrl = `/category/${encodeURIComponent(name)}/`;
const current = page.currentPage;
const total = page.lastPage;
---

<MainGridLayout
	title={`分类：${name}`}
	description={`分类 ${name} 下的全部文章`}
	canonicalUrl={getPaginationUrl(rootUrl, current)}
	prevUrl={current > 1 ? getPaginationUrl(rootUrl, current - 1) : undefined}
	nextUrl={current < total
		? getPaginationUrl(rootUrl, current + 1)
		: undefined}
>
	<div class="page category-page">
		<header class="post-header">
			<h2>
				<i class="fa fa-folder-open-o" aria-hidden="true"></i>
				分类：{name}
			</h2>
		</header>
		<address class="post-metaa">
			<i class="fa fa-home" aria-hidden="true"></i>
			<a href="/" title="返回首页">首页</a>
			&raquo;
			<a href="/category/" title="返回分类云集">分类云集</a>
			&raquo;
			<i class="fa fa-folder-open-o" aria-hidden="true"></i>
			{name}
		</address>

		<div class="post-context">
			<p>共 {page.total} 篇文章</p>
		</div>

		<ul id="blogtags">
			<li class="tag-cloud-items">
				{
					categories.map((cat) => (
						<a
							href={`/category/${encodeURIComponent(cat.name)}/`}
							title={`${cat.count}篇文章`}
							aria-current={
								cat.name === name ? "page" : undefined
							}
							class:list={[{ "is-current": cat.name === name }]}
						>
							{cat.name}
							<span class="tag-count">&times;{cat.count}</span>
						</a>
					))
				}
			</li>
		</ul>
	</div>

	{page.data.map((post) => <PostCard post={post} />)}

	<Pagination
		current={current}
		total={total}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
