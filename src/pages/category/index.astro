---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import ListingHeader from "../../components/layout/ListingHeader.astro";
import TagPillCloud from "../../components/layout/TagPillCloud.astro";
import { getCollection } from "astro:content";
import { getCategoryList, isPublicPost } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const publicPosts = allPosts.filter(isPublicPost);
const categories = getCategoryList(allPosts);
---

<MainGridLayout title="分类云集" description="全站分类总览，按文章数排序">
	<div class="page categories-page">
		<ListingHeader
			icon="fa-folder-open-o"
			title="分类云集"
			crumbs={[{ label: "分类云集", icon: "fa-folder-open-o" }]}
		/>

		<div class="post-context">
			<p>
				共 {categories.length} 个分类 · 收录 {publicPosts.length} 篇文章
			</p>
			{categories.length === 0 && <p>暂无分类。</p>}
		</div>

		{
			categories.length > 0 && (
				<TagPillCloud items={categories} base="category" />
			)
		}
	</div>
</MainGridLayout>
