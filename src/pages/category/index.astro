---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getCategoryList, isPublicPost } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const publicPosts = allPosts.filter(isPublicPost);
const categories = getCategoryList(allPosts);
---

<MainGridLayout title="分类云集" description="全站分类总览，按文章数排序">
	<div class="page categories-page">
		<header class="post-header">
			<h2>
				<i class="fa fa-folder-open-o" aria-hidden="true"></i> 分类云集
			</h2>
		</header>
		<address class="post-metaa">
			<i class="fa fa-home" aria-hidden="true"></i>
			<a href="/" title="返回首页">首页</a>
			&raquo;
			<i class="fa fa-folder-open-o" aria-hidden="true"></i>
			分类云集
		</address>

		<div class="post-context">
			<p>
				共 {categories.length} 个分类 · 收录 {publicPosts.length} 篇文章
			</p>
			{categories.length === 0 && <p>暂无分类。</p>}
		</div>

		{
			categories.length > 0 && (
				<ul id="blogtags">
					<li class="tag-cloud-items">
						{categories.map((cat) => (
							<a
								href={`/category/${encodeURIComponent(cat.name)}/`}
								title={`${cat.count}篇文章`}
							>
								{cat.name}
								<span class="tag-count">
									&times;{cat.count}
								</span>
							</a>
						))}
					</li>
				</ul>
			)
		}
	</div>
</MainGridLayout>
