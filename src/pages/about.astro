---
import fs from "node:fs";
import path from "node:path";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { siteConfig } from "../config";
import { getCollection, render } from "astro:content";
import {
	renderContributionsCalendar,
	renderContributionsFallback,
} from "../utils/contributions-calendar";

const specPages = await getCollection("spec");
const aboutPage = specPages.find((p) => p.id === "about");
const aboutContent = aboutPage ? await render(aboutPage) : null;

// 缓存由 scripts/fetch-github-contributions.mjs 在构建期生成并入库；
// 文件缺失或形状非法（首次构建前/无令牌/坏数据）时渲染回退卡而不是让构建失败。
// 注意用 cwd 定位：import.meta.url 在 astro build 的打包产物里指向 dist/chunks，
// 相对解析会扑空（dev 正常、build 走回退的隐性差异）。
let calendarHtml: string;
try {
	const raw = fs.readFileSync(
		path.resolve(process.cwd(), "src", "constants", "github-contributions.json"),
		"utf-8",
	);
	calendarHtml = renderContributionsCalendar(JSON.parse(raw));
} catch {
	calendarHtml = renderContributionsFallback();
}
---

<MainGridLayout
	title="关于我"
	description={`关于 ${siteConfig.author}`}
	showSidebar={false}
	searchIndex
>
	{/* 稿纸字体：平方时光体（ZeoSeven FontsAPI，src 含 local() 本机优先）+ 方正书宋（jsDelivr 分包，回退字体） */}
	<head slot="head">
		<link
			rel="stylesheet"
			href="https://fontsapi.zeoseven.com/156/main/result.css"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/cn-fontsource-fz-shu-song-z-01-regular/font.css"
		/>
	</head>
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h2>
					<i class="fa fa-user" aria-hidden="true"></i> 关于我
				</h2>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
			<i class="fa fa-user" aria-hidden="true"></i>
			关于我
			</address>

			<Fragment set:html={calendarHtml} />

			{aboutContent ? (
				<div class="post-context prose">
					<aboutContent.Content />
				</div>
			) : (
				<div class="post-context">
					<p>
						你好！我是 <b>{siteConfig.author}</b>，这里是
						<b>{siteConfig.title}</b>。
					</p>
					<p>关于页面内容在 <code>src/content/spec/about.md</code> 中编辑。</p>
				</div>
			)}
		</article>
	</div>
</MainGridLayout>
