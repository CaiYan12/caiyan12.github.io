---
/**
 * /books/:id/ — 书籍详情（独立壳，零客户端 JS：同架与元信息全部 SSR）
 * getStaticPaths 为每本书生成静态页；无效 id 不进入本页（Astro 静态
 * 行为自然落站级 404，契约「正式 404 行为」）。
 * SEO（契约 §40）：每本唯一 title/description/canonical/og。
 */
import { books, getSameShelf } from "../../nice-books/data/books";
import type { Book } from "../../nice-books/types";
import {
	coverHTML,
	noteHTML,
	tagPillHTML,
	bookCardHTML,
} from "../../nice-books/lib/render";
import { formatAuthors } from "../../nice-books/lib/format";
import SiteHead from "../../nice-books/components/SiteHead.astro";
import SiteHeader from "../../nice-books/components/SiteHeader.astro";
import SiteFooter from "../../nice-books/components/SiteFooter.astro";

export function getStaticPaths() {
	return books.map((book) => ({
		params: { id: book.id },
		props: { book, sameShelf: getSameShelf(book, 4) },
	}));
}

interface Props {
	book: Book;
	sameShelf: Book[];
}
const { book, sameShelf } = Astro.props;
const metaDescription =
	book.description.length > 90
		? `${book.description.slice(0, 89)}…`
		: book.description;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<SiteHead
			title={`《${book.title}》 · Nice Books 每日好书`}
			description={metaDescription}
			canonicalPath={`/books/${book.id}/`}
		/>
		{
			/* 精选摘抄手写字体：平方时光体（照搬 about.astro:51 先例，仅详情页加载） */
		}
		<link
			rel="stylesheet"
			href="https://fontsapi.zeoseven.com/156/main/result.css"
		/>
	</head>
	<body class="nb-page font-nb-body text-[15.5px] leading-[1.85] text-nb-ink">
		<SiteHeader active="archive" />
		<main
			id="nb-books-main"
			class="transition-swup-fade mx-auto max-w-[1080px] px-6 max-[540px]:px-4"
			data-pagefind-ignore="all"
		>
			<p class="pb-5 pt-8 text-[13.5px]">
				<a
					class="nb-back-link inline-flex min-h-11 items-center text-nb-ink-soft no-underline hover:text-nb-blue"
					href="/books/archive/"
					><span class="nb-back-link-label">← 返回书库</span></a
				>
			</p>

			<article class="relative pb-3 pt-14 max-[540px]:pt-12">
				<span class="nb-detail-hanger" aria-hidden="true">
					<i class="nb-detail-hanger-line"></i>
					<i class="nb-detail-hanger-marker"></i>
				</span>
				<div
					class="grid grid-cols-[240px_1fr] gap-x-11 gap-y-8 max-[960px]:grid-cols-[210px_1fr] max-[960px]:gap-x-8 max-[820px]:grid-cols-1 max-[820px]:gap-y-7"
				>
					<div
						class="col-start-2 row-start-1 max-[820px]:col-auto max-[820px]:row-auto"
					>
						<h1
							class="font-nb-serif text-[30px] leading-[1.4] tracking-[1px] max-[540px]:text-[25px]"
						>
							{book.title}
						</h1>
						<p class="mt-2 text-[15px] text-nb-ink-soft">
							{formatAuthors(book)}
						</p>
					</div>
					<div
						class="col-start-1 row-span-3 row-start-1 self-start max-w-[230px] max-[820px]:col-auto max-[820px]:row-auto max-[820px]:row-span-1 max-[820px]:mx-auto max-[820px]:order-2 max-[540px]:max-w-[190px]"
					>
						<Fragment
							set:html={coverHTML(book, {
								marker: true,
								variant: "hero",
							})}
						/>
						{
							book.coverUrl === null && (
								<p class="mt-3 text-[13px] leading-[1.8] text-nb-muted">
									※ 因版权原因，未使用实体书封面
									<br />
									程序生成的书封外壳仅作示意
								</p>
							)
						}
					</div>
					<div
						class="col-start-2 row-start-2 max-[820px]:col-auto max-[820px]:row-auto max-[820px]:order-3"
					>
						<dl class="mt-[22px]">
							<div
								class="grid grid-cols-[76px_1fr] items-baseline gap-3 border-b border-dashed border-nb-border py-[9px]"
							>
								<dt class="text-[13px] text-nb-muted">
									出版社
								</dt>
								<dd class="text-[14.5px]">{book.publisher}</dd>
							</div>
							<div
								class="grid grid-cols-[76px_1fr] items-baseline gap-3 border-b border-dashed border-nb-border py-[9px]"
							>
								<dt class="text-[13px] text-nb-muted">版次</dt>
								<dd class="text-[14.5px]">
									{book.firstEdition.edition} · {
										book.firstEdition.year
									} 年
								</dd>
							</div>
							<div
								class="grid grid-cols-[76px_1fr] items-baseline gap-3 border-b border-dashed border-nb-border py-[9px]"
							>
								<dt class="text-[13px] text-nb-muted">标签</dt>
								<dd
									class="flex flex-wrap gap-2 [&>a]:min-h-11 [&>a]:items-center"
								>
									{
										book.tags.map((t) => (
											<Fragment
												set:html={tagPillHTML(t, {
													variant: "link",
												})}
											/>
										))
									}
								</dd>
							</div>
						</dl>
						<section class="mt-[34px]">
							<h2
								class="mb-3 flex items-center gap-2.5 font-nb-serif text-lg tracking-[1px]"
							>
								<span
									class="h-2 w-2 rotate-45 bg-nb-seal"
									aria-hidden="true"></span>内容简介
							</h2>
							<p
								class="max-w-[42em] text-[15.5px] leading-[2.05] text-nb-ink-soft"
							>
								{book.description}
							</p>
						</section>
						<section class="mt-[34px]" aria-label="站长荐语">
							<Fragment
								set:html={noteHTML(book, {
									stamp: true,
									extraClass: "mt-1",
								})}
							/>
						</section>
						{
							book.excerpts && book.excerpts.length > 0 && (
								<section
									class="mt-[34px]"
									aria-labelledby="nb-excerpts-title"
								>
									<h2
										id="nb-excerpts-title"
										class="mb-5 flex items-center gap-2.5 font-nb-serif text-lg tracking-[1px]"
									>
										<span
											class="h-2 w-2 rotate-45 bg-nb-seal"
											aria-hidden="true"
										/>
										精选摘抄
									</h2>
									<div class="nb-excerpt-grid">
										{book.excerpts.map((text) => (
											<blockquote class="nb-excerpt-card nb-tape">
												<p>{text}</p>
												<cite>—— 《{book.title}》</cite>
											</blockquote>
										))}
									</div>
								</section>
							)
						}
					</div>
				</div>
			</article>

			{
				sameShelf.length > 0 && (
					<section
						class="mt-[72px]"
						aria-labelledby="nb-related-title"
					>
						<h2
							id="nb-related-title"
							class="font-nb-serif text-[22px] font-bold leading-[1.4] tracking-[1px]"
						>
							<span
								class="mr-3 inline-block -translate-y-[7px] font-nb-mono text-[13px] tracking-[1px] text-nb-seal"
								aria-hidden="true"
							>
								+
							</span>
							同架图书
						</h2>
						<p class="mb-5 mt-1.5 text-[13px] text-nb-muted">
							架子上标签相近的书，顺手也翻翻。
						</p>
						<ul class="nb-related-grid gap-[22px] max-[960px]:gap-4 max-[540px]:gap-3">
							<Fragment
								set:html={sameShelf
									.map((b) =>
										bookCardHTML(b, undefined, {
											related: true,
										}),
									)
									.join("")}
							/>
						</ul>
					</section>
				)
			}
		</main>
		<SiteFooter />
		<script>
			import "../../nice-books/scripts/main";
		</script>
	</body>
</html>
