---
import NiceBooksLegacyRedirect from "../../components/NiceBooksLegacyRedirect.astro";
import { NICE_BOOKS_LEGACY_IDS } from "../../data/nice-books-legacy-ids";

export function getStaticPaths() {
	return NICE_BOOKS_LEGACY_IDS.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
if (!id) throw new Error("Missing legacy Nice Books ID");
const destination = `/nice-books/${id}/`;
---

<NiceBooksLegacyRedirect destination={destination} />
