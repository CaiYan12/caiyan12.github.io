---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostCard from "../components/layout/PostCard.astro";
import Pagination from "../components/layout/Pagination.astro";
import Slideshow from "../components/control/Slideshow.astro";
import { getCollection } from "astro:content";
import { getSortedPosts, isPublicPost } from "../utils/content-utils";
import { getPaginationUrl } from "../utils/pagination";
import { siteConfig } from "../config";

const allPosts = await getCollection("posts");
const posts = getSortedPosts(allPosts.filter(isPublicPost));
const pages = Math.max(1, Math.ceil(posts.length / siteConfig.postsPerPage));
const rootUrl = "/";
const pagePosts = posts.slice(0, siteConfig.postsPerPage);
---

<MainGridLayout
	canonicalUrl={rootUrl}
	nextUrl={pages > 1 ? getPaginationUrl(rootUrl, 2) : undefined}
	description={siteConfig.subtitle}
>
	<Slideshow />

	{
		pagePosts.length > 0 ? (
			pagePosts.map((post) => <PostCard post={post} />)
		) : (
			<div class="page">
				<article role="article">
					<header class="post-header">
						<h2>
							<i
								class="fa fa-question-circle"
								aria-hidden="true"
							/>
							Nothing Found!
						</h2>
					</header>
					<div class="post-context">
						对不起，你要搜索的内容在本站搜不到任何结果，请尝试其他关键词！
					</div>
				</article>
			</div>
		)
	}

	<Pagination
		current={1}
		total={pages}
		urlTemplate={getPaginationUrl(rootUrl, "{n}")}
		firstPageUrl={rootUrl}
	/>
</MainGridLayout>
