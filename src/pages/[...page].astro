---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostCard from "../components/layout/PostCard.astro";
import Pagination from "../components/layout/Pagination.astro";
import Slideshow from "../components/control/Slideshow.astro";
import { getCollection } from "astro:content";
import { getSortedPosts } from "../utils/content-utils";
import { siteConfig } from "../config";

export async function getStaticPaths() {
	const allPosts = await getCollection("posts");
	const posts = getSortedPosts(allPosts).filter((p) => !p.data.draft);
	const pages = Math.max(1, Math.ceil(posts.length / siteConfig.postsPerPage));

	const paths: {
		params: { page: string | undefined };
		props: { posts: typeof posts; current: number; pages: number };
	}[] = [];
	for (let i = 1; i <= pages; i++) {
		paths.push({
			// 第 1 页渲染在根路径 /，其余在 /page/N/
			params: { page: i === 1 ? undefined : `page/${i}` },
			props: {
				posts: posts.slice((i - 1) * siteConfig.postsPerPage, i * siteConfig.postsPerPage),
				current: i,
				pages,
			},
		});
	}
	return paths;
}

const { posts, current, pages } = Astro.props;
const isFirstPage = current === 1;
---

<MainGridLayout
	title={current > 1 ? `第 ${current} 页` : undefined}
	description={siteConfig.subtitle}
>
	{/* 幻灯片：仅首页第一页显示（对应 log_list.php 的 index_slide） */}
	{isFirstPage && <Slideshow />}

	{posts.length > 0 ? (
		posts.map((post) => <PostCard post={post} />)
	) : (
		<div class="page">
			<article role="article">
				<header class="post-header">
					<h2>
						<i class="fa fa-question-circle" aria-hidden="true"></i>
						Nothing Found!
					</h2>
				</header>
				<div class="post-context">
					对不起，你要搜索的内容在本站搜不到任何结果，请尝试其他关键词！
				</div>
			</article>
		</div>
	)}

	<Pagination current={current} total={pages} urlTemplate="/page/{n}/" />
</MainGridLayout>
