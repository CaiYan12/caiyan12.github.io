---
import AiNewsApp from "../../ai-news/AiNewsApp";
import { siteConfig } from "../../config";

const pageTitle = `AI 日报 - ${siteConfig.title}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<title>{pageTitle}</title>
		<meta
			name="description"
			content="WindowsIt's Music Club 的 AI 日报阅读页"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index,follow" />
		<link rel="icon" href="/images/avatar.webp" type="image/webp" />
	</head>
	<body>
		<main id="ai-news-root" data-pagefind-ignore="all">
			<AiNewsApp client:only="react" />
		</main>
	</body>
</html>
