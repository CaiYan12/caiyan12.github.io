---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import SeriesListing from "../../components/layout/SeriesListing.astro";
import { getCollection } from "astro:content";
import {
	getSortedPosts,
	isPublicPost,
	resolveSeriesMeta,
} from "../../utils/content-utils";
import { seriesList } from "../../data/series";
import { getPaginationUrl } from "../../utils/pagination";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
	const allPosts = await getCollection("posts");
	const publicPosts = allPosts.filter(isPublicPost);
	const sortedPosts = getSortedPosts(publicPosts);
	return seriesList.map(({ slug }) => {
		const meta = resolveSeriesMeta(slug);
		// 成员按 seriesOrder 升序（组内顺序不跟发布时间）
		const posts = sortedPosts
			.filter((post) => post.data.series === slug)
			.sort(
				(a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0),
			);
		return {
			params: { slug },
			props: { meta, posts },
		};
	});
}

const { meta, posts } = Astro.props;
const rootUrl = `/series/${meta.slug}/`;
const pages = Math.max(1, Math.ceil(posts.length / siteConfig.postsPerPage));
const pagePosts = posts.slice(0, siteConfig.postsPerPage);
---

<MainGridLayout
	title={`文集：${meta.name}`}
	description={meta.description}
	canonicalUrl={rootUrl}
	nextUrl={pages > 1 ? getPaginationUrl(rootUrl, 2) : undefined}
>
	<SeriesListing
		name={meta.name}
		unit={meta.unit}
		totalCount={posts.length}
		posts={pagePosts}
		current={1}
		total={pages}
		rootUrl={rootUrl}
	/>
</MainGridLayout>
