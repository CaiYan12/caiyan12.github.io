---
import MainGridLayout from "../../../../layouts/MainGridLayout.astro";
import SeriesListing from "../../../../components/layout/SeriesListing.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getSeriesView } from "../../../../utils/series";
import { seriesList } from "../../../../data/series";
import { getPaginationUrl, getPageMeta } from "../../../../utils/pagination";
import { siteConfig } from "../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getCollection("posts");
	return seriesList.flatMap((registered) => {
		// 元数据/成员/封面都来自 view：series.unit 已补缺省，模板不再写 `?? "篇"`
		const view = getSeriesView(allPosts, registered.slug);
		return paginate(view.members, {
			params: { slug: registered.slug },
			props: { series: view.series, cover: view.cover },
			pageSize: siteConfig.postsPerPage,
		});
	});
}) satisfies GetStaticPaths;

const { page, series, cover } = Astro.props;
const rootUrl = `/series/${series.slug}/`;
const pageMeta = getPageMeta(
	{ title: `文集：${series.name}`, description: series.description },
	page.currentPage,
);
---

<MainGridLayout
	title={pageMeta.title}
	description={pageMeta.description}
	image={cover ?? undefined}
	canonicalUrl={getPaginationUrl(rootUrl, page.currentPage)}
	prevUrl={page.currentPage > 1
		? getPaginationUrl(rootUrl, page.currentPage - 1)
		: undefined}
	nextUrl={page.currentPage < page.lastPage
		? getPaginationUrl(rootUrl, page.currentPage + 1)
		: undefined}
>
	<SeriesListing
		name={series.name}
		unit={series.unit}
		totalCount={page.total}
		posts={page.data}
		current={page.currentPage}
		total={page.lastPage}
		rootUrl={rootUrl}
		cover={cover}
	/>
</MainGridLayout>
