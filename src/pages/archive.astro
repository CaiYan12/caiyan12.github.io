---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getArchiveList } from "../utils/content-utils";
import dayjs from "dayjs";

const allPosts = await getCollection("posts");
const archives = getArchiveList(allPosts);
---

<MainGridLayout title="文章归档" description="全站文章按年月归档">
	<div class="page">
		<header class="post-header">
			<h2>
				<i class="fa fa-archive" aria-hidden="true"></i> 文章归档
			</h2>
		</header>
		<address class="post-metaa">
			<i class="fa fa-home" aria-hidden="true"></i>
			<a href="/" title="返回首页">首页</a>
			&raquo;
			<i class="fa fa-file-text-o" aria-hidden="true"></i>
			文章归档
		</address>

		<div class="archive-list">
			{archives.map(([month, posts]) => (
				<section>
					<h3>
						<i class="fa fa-calendar-o" aria-hidden="true"></i>
						<a href={`/archive/${month.replace("年", "-").replace("月", "")}/`}>
							{month}
						</a>
						<span class="text-xs font-normal text-gray-400">
							（{posts.length} 篇）
						</span>
					</h3>
					<ul>
						{posts.map((post) => (
							<li>
								<a href={`/posts/${post.id}/`} title={post.data.title}>
									{post.data.title}
								</a>
								<span class="date">
									{dayjs(post.data.published).format("YYYY-MM-DD")}
								</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</div>
</MainGridLayout>
