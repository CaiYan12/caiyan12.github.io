---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { friends } from "../data/friends";

const getFriendHostname = (url: string) => new URL(url).hostname;
const getFriendFavicon = (url: string) => new URL("/favicon.ico", url).href;
const getFriendFaviconFallback = (url: string) =>
	`https://www.google.com/s2/favicons?domain=${encodeURIComponent(getFriendHostname(url))}&sz=64`;
---

<MainGridLayout title="友情链接" description="我的友情链接" showSidebar={false}>
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h2>
					<i class="fa fa-link" aria-hidden="true"></i> 友情链接
				</h2>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-link" aria-hidden="true"></i>
				友情链接
			</address>
			<div class="post-context">
				<p>
					交换友链请在留言板留言，附上站点名称、网址和一句简介。本站友链要求：原创内容优先，无不良内容。
				</p>
			</div>

			<div class="link-content">
				{friends.map((f) => (
					<a
						href={f.url}
						target="_blank"
						rel="nofollow noopener noreferrer"
						title={f.description || f.name}
					>
						<div class="friend-card-head">
							<span class="friend-card-avatar" aria-hidden="true">
								<span class="friend-card-avatar-fallback">{f.name.slice(0, 1)}</span>
								<img
									src={f.avatar || getFriendFavicon(f.url)}
									data-fallback-src={getFriendFaviconFallback(f.url)}
									alt=""
									loading="lazy"
									decoding="async"
									onerror="if (this.dataset.fallbackSrc && this.getAttribute('src') !== this.dataset.fallbackSrc) { this.setAttribute('src', this.dataset.fallbackSrc); } else { this.remove(); }"
								/>
							</span>
							<span class="friend-card-heading">
								<span class="fname">{f.name}</span>
								<span class="friend-domain">{getFriendHostname(f.url)}</span>
							</span>
						</div>
						{f.description && <div class="fdes">{f.description}</div>}
						{f.tags.length > 0 && (
							<div class="friend-card-tags" aria-label="标签">
								{f.tags.map((tag) => <span class="friend-card-tag">#{tag}</span>)}
							</div>
						)}
						<span class="friend-card-action">
							<span>访问站点</span>
							<i class="fa fa-external-link" aria-hidden="true"></i>
						</span>
					</a>
				))}
			</div>
		</article>
	</div>
</MainGridLayout>
