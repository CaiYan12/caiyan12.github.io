---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { friends } from "../data/friends";
import friendIconManifestData from "../constants/friend-icons.json";

const getFriendHostname = (url: string) => new URL(url).hostname;

const normalizeFriendUrl = (value: unknown) => {
	if (typeof value !== "string" || !value.trim()) return null;
	try {
		const parsed = new URL(value.trim());
		if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
			return null;
		}
		parsed.protocol = parsed.protocol.toLowerCase();
		parsed.hostname = parsed.hostname.toLowerCase();
		if (
			(parsed.protocol === "http:" && parsed.port === "80") ||
			(parsed.protocol === "https:" && parsed.port === "443")
		) {
			parsed.port = "";
		}
		parsed.hash = "";
		if (!parsed.pathname) parsed.pathname = "/";
		return parsed.href;
	} catch {
		return null;
	}
};

const isRootRelativePath = (value: unknown): value is string =>
	typeof value === "string" &&
	value.startsWith("/") &&
	!value.startsWith("//") &&
	!value.includes("://");

const friendIconPaths = new Map<string, string>();
const rawManifest: unknown = friendIconManifestData;
if (
	rawManifest &&
	typeof rawManifest === "object" &&
	"schemaVersion" in rawManifest &&
	rawManifest.schemaVersion === 1 &&
	"entries" in rawManifest &&
	Array.isArray(rawManifest.entries)
) {
	for (const entry of rawManifest.entries) {
		if (!entry || typeof entry !== "object") continue;
		const friendUrl = normalizeFriendUrl(
			"friendUrl" in entry ? entry.friendUrl : null,
		);
		const localPath = "localPath" in entry ? entry.localPath : null;
		if (friendUrl && isRootRelativePath(localPath)) {
			friendIconPaths.set(friendUrl, localPath);
		}
	}
}

const getFriendIconPath = (url: string) =>
	friendIconPaths.get(normalizeFriendUrl(url) ?? "");
---

<MainGridLayout title="友情链接" description="我的友情链接" showSidebar={false}>
	<div class="page">
		<article role="article">
			<header class="post-header">
				<h1>
					<i class="fa fa-link" aria-hidden="true"></i> 友情链接
				</h1>
			</header>
			<address class="post-metaa">
				<i class="fa fa-home" aria-hidden="true"></i>
				<a href="/" title="返回首页">首页</a>
				&raquo;
				<i class="fa fa-link" aria-hidden="true"></i>
				友情链接
			</address>
			<div class="post-context">
				<p>
					交换友链请在留言板留言，附上站点名称、网址和一句简介。本站友链要求：原创内容优先，无不良内容。
				</p>
			</div>

			<div class="link-content">
				{
					friends.map((f) => (
						<a
							href={f.url}
							target="_blank"
							rel="nofollow noopener noreferrer"
							title={f.description || f.name}
						>
							<div class="friend-card-head">
								<span
									class="friend-card-avatar"
									aria-hidden="true"
								>
									<span class="friend-card-avatar-fallback">
										{f.name.slice(0, 1)}
									</span>
									{getFriendIconPath(f.url) && (
										<img
											src={getFriendIconPath(f.url)}
											alt=""
											loading="lazy"
											decoding="async"
											onerror="this.remove()"
										/>
									)}
								</span>
								<span class="friend-card-heading">
									<span class="fname">{f.name}</span>
									<span class="friend-domain">
										{getFriendHostname(f.url)}
									</span>
								</span>
							</div>
							{f.description && (
								<div class="fdes">{f.description}</div>
							)}
							{f.tags.length > 0 && (
								<div class="friend-card-tags" aria-label="标签">
									{f.tags.map((tag) => (
										<span class="friend-card-tag">
											#{tag}
										</span>
									))}
								</div>
							)}
							<span class="friend-card-action">
								<span>访问站点</span>
								<i
									class="fa fa-external-link"
									aria-hidden="true"
								/>
							</span>
						</a>
					))
				}
			</div>
		</article>
	</div>
</MainGridLayout>
