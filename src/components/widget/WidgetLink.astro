---
import WidgetLayout from "./WidgetLayout.astro";
import { friends } from "../../data/friends";
---

<WidgetLayout title="友情链接" icon="fa-link">
	<a
		slot="actions"
		class="widget-more-link"
		href="/friends/"
		title="查看友情链接"
	>
		<i class="fa fa-external-link" aria-hidden="true"></i>
		<span>更多详情</span>
	</a>
	<ul id="link">
		{
			friends.map((f) => (
				<li>
					<i class="fa fa-angle-right" aria-hidden="true" />
					<a
						href={f.url}
						target="_blank"
						rel="nofollow"
						title={f.description}
					>
						{f.name}
					</a>
				</li>
			))
		}
	</ul>
</WidgetLayout>
