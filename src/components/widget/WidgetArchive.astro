---
import WidgetLayout from "./WidgetLayout.astro";
import { getCollection } from "astro:content";
import { getArchiveList } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const archives = getArchiveList(allPosts);
// 侧栏上限：#record li 与 #blogsort 同族（min-width:110px 浮动项，两列布局），
// 4 行 = 8 项。数据侧截断防浮动行被腰斩；全量走「更多详情」进 /archive/。
const SIDEBAR_ROW_LIMIT = 4;
const SIDEBAR_COLUMN_COUNT = 2;
const visibleArchives = archives.slice(
	0,
	SIDEBAR_ROW_LIMIT * SIDEBAR_COLUMN_COUNT,
);
---

<WidgetLayout title="文章归档" icon="fa-archive">
	<a
		slot="actions"
		class="widget-more-link"
		href="/archive/"
		title="查看文章归档"
	>
		<i class="fa fa-calendar" aria-hidden="true" />
		<span>更多详情</span>
	</a>
	<ul id="record">
		{
			visibleArchives.map(([month, monthPosts]) => (
				<li>
					<i class="fa fa-angle-right" aria-hidden="true" />
					<a
						href={`/archive/${month.replace("年", "/").replace("月", "")}/`}
					>
						{month}
					</a>
					<span>{monthPosts.length}</span>
				</li>
			))
		}
	</ul>
</WidgetLayout>
