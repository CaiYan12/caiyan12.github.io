---
import WidgetLayout from "./WidgetLayout.astro";
import { getCollection } from "astro:content";
import { getSeriesViewForPost } from "../../utils/series";

// 仅在文章页侧栏显示：从 URL 提取当前文章 slug（与 WidgetRelatedPosts 同法）。
// 成员判定单源：getSeriesViewForPost 即「组内序列」口径——该文不在公开时间线
// （草稿/私密帖被过滤）、不属于任何文集或所属 slug 未登记时为 null，私密成员
// 不会被列进目录。侧栏在 swup 容器 <main> 内，换页时整个 <main> 被替换，
// 构建期判定自动重新求值——零客户端脚本。
const slug = Astro.url.pathname.replace(/\/+$/, "").split("/")[2];
const view = slug
	? getSeriesViewForPost(await getCollection("posts"), slug)
	: null;
---

{
	view && (
		<WidgetLayout title="文集目录" icon="fa-list-ol" class="widget-series">
			{/* 标题栏 actions 槽：与「换一批」同族（图标 + 文字，hover 变绿），导航用 <a> */}
			<a
				slot="actions"
				class="series-toc-link"
				href={`/series/${view.series.slug}/`}
				title={`查看《${view.series.name}》目录`}
			>
				<i class="fa fa-book" aria-hidden="true" />
				<span>查看目录</span>
			</a>
			<ol class="series-toc">
				{view.members.map((member) => (
					<li class:list={[member.id === slug && "current"]}>
						<a
							href={`/posts/${member.id}/`}
							title={member.data.title}
							aria-current={
								member.id === slug ? "page" : undefined
							}
						>
							{member.data.title}
						</a>
					</li>
				))}
			</ol>
		</WidgetLayout>
	)
}
