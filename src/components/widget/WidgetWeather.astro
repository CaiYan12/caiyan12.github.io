---
import WidgetLayout from "./WidgetLayout.astro";
---

<WidgetLayout title="附近天气">
	<button
		slot="actions"
		class="weather-widget__refresh"
		type="button"
		aria-label="刷新附近天气"
		data-weather-refresh
		hidden
	>
		<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
			<path
				d="M13.7 4.3V1.8m0 2.5h-2.5M2.3 11.7v2.5m0-2.5h2.5M3.5 5.1a5.2 5.2 0 0 1 8.8-1.7l1.4 1.4M12.5 10.9a5.2 5.2 0 0 1-8.8 1.7l-1.4-1.4"
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.4"></path>
		</svg>
		刷新
	</button>
	<div
		class="weather-widget-body"
		data-weather-widget
		data-weather-state="idle"
	>
		<p
			class="weather-widget__status"
			data-weather-info
			data-weather-status
			role="status"
			aria-live="polite"
		>
			启用 JavaScript 后可查看附近天气
		</p>
		<div class="weather-widget__reading" data-weather-reading hidden>
			<div class="weather-widget__current">
				<svg
					class="weather-widget__icon"
					viewBox="0 0 64 64"
					aria-hidden="true"
					data-weather-icon
					data-weather-kind="clear"
				>
					<g
						data-weather-part="clear"
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-width="4"
					>
						<circle
							cx="32"
							cy="32"
							r="11"
							fill="currentColor"
							stroke="none"></circle>
						<path
							d="M32 5v7M32 52v7M5 32h7M52 32h7M13 13l5 5m28 28 5 5m0-38-5 5M18 46l-5 5"
						></path>
					</g>
					<g data-weather-part="cloud" fill="currentColor">
						<path
							d="M17 47h31a9 9 0 0 0 .5-18 16 16 0 0 0-30.7-2.3A10.3 10.3 0 0 0 17 47Z"
						></path>
					</g>
					<g data-weather-part="rain" fill="currentColor">
						<path
							d="M17 38h31a9 9 0 0 0 .5-18 16 16 0 0 0-30.7-2.3A10.3 10.3 0 0 0 17 38Z"
						></path>
						<path d="m23 44-3 7m14-7-3 7m14-7-3 7"></path>
					</g>
					<g
						data-weather-part="snow"
						fill="currentColor"
						stroke="currentColor"
						stroke-width="1.5"
					>
						<path
							d="M17 36h31a9 9 0 0 0 .5-18 16 16 0 0 0-30.7-2.3A10.3 10.3 0 0 0 17 36Z"
						></path>
						<path
							d="M22 44v10m-4-7 8 4m0-8-8 4m18-7v10m-4-7 8 4m0-8-8 4m18-7v10m-4-7 8 4m0-8-8 4"
							fill="none"></path>
					</g>
					<g data-weather-part="storm" fill="currentColor">
						<path
							d="M17 38h31a9 9 0 0 0 .5-18 16 16 0 0 0-30.7-2.3A10.3 10.3 0 0 0 17 38Z"
						></path>
						<path d="m34 36-10 15h8l-2 10 12-17h-8l3-8Z"></path>
					</g>
					<g
						data-weather-part="fog"
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-width="4"
					>
						<path
							d="M17 33h31a9 9 0 0 0 .5-18 16 16 0 0 0-30.7-2.3A10.3 10.3 0 0 0 17 33Z"
							fill="currentColor"
							stroke="none"></path>
						<path d="M13 42h38M18 51h29"></path>
					</g>
				</svg>
				<p class="weather-widget__temperature" data-weather-temperature>
				</p>
			</div>
			<p class="weather-widget__city" data-weather-city></p>
			<p class="weather-widget__description" data-weather-description></p>
			<p class="weather-widget__stale" data-weather-stale hidden>
				旧数据
			</p>
			<p class="weather-widget__source-line">
				<span data-weather-fetched-at></span>
				<span aria-hidden="true"> · </span>
				<a
					class="weather-widget__source"
					data-weather-source
					target="_blank"
					rel="noopener noreferrer"></a>
			</p>
		</div>
		<button
			class="weather-widget__retry"
			type="button"
			data-weather-retry
			hidden>重试获取附近天气</button
		>
	</div>
</WidgetLayout>
