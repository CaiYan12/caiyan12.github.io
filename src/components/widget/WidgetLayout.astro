---
interface Props {
	title: string;
	icon?: string;
	/** 修饰类（如 WidgetSeries 的 "widget-series" 用于粘性定位）；不传则零差异 */
	class?: string;
}

const { title, icon, class: className } = Astro.props;
---

<section class:list={["widget", className]}>
	{
		icon && (
			<span class="icon">
				<i class={`fa ${icon}`} aria-hidden="true" />
			</span>
		)
	}
	<h2>
		{title}
		<slot name="actions" />
	</h2>
	<slot />
</section>
