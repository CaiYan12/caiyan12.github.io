---
interface Props {
	title: string;
	icon?: string;
}

const { title, icon } = Astro.props;
---

<section class="widget">
	{
		icon && (
			<span class="icon">
				<i class={`fa ${icon}`} aria-hidden="true" />
			</span>
		)
	}
	<h2>
		{title}
		<slot name="actions" />
	</h2>
	<slot />
</section>
