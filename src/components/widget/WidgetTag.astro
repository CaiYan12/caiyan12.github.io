---
import WidgetLayout from "./WidgetLayout.astro";
import TagPillCloud from "../layout/TagPillCloud.astro";
import { getCollection } from "astro:content";
import { getTagList } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const tags = getTagList(allPosts);
---

<WidgetLayout title="标签云集" icon="fa-tags">
	<a slot="actions" class="widget-more-link" href="/tag/" title="查看标签云集">
		<i class="fa fa-tag" aria-hidden="true" />
		<span>更多详情</span>
	</a>
	<TagPillCloud items={tags} base="tag" showCount={false} dedupeId />
</WidgetLayout>
