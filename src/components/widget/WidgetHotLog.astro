---
import WidgetLayout from "./WidgetLayout.astro";
import { getCollection } from "astro:content";
import { getHotPosts } from "../../utils/content-utils";
import dayjs from "dayjs";

const allPosts = await getCollection("posts");
const hotPosts = getHotPosts(allPosts, 8);

// 仅在首页列表页（/ 与 /page/N/）显示
const isHomePage =
	Astro.url.pathname === "/" || /^\/page\/\d+\/?$/.test(Astro.url.pathname);
---

{isHomePage && (
	<WidgetLayout title="热门推荐" icon="fa-fire">
		<ul id="hotlog">
			{hotPosts.map((post) => (
				<li>
					<i class="fa fa-angle-right" aria-hidden="true"></i>
					<a href={`/posts/${post.id}/`} title={post.data.title}>
						{post.data.title}
					</a>
					<span>{dayjs(post.data.published).format("MM-DD")}</span>
				</li>
			))}
		</ul>
	</WidgetLayout>
)}
