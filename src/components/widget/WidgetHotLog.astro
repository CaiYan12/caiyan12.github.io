---
import WidgetLayout from "./WidgetLayout.astro";
import { getCollection } from "astro:content";
import { getHotPosts } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const hotPosts = getHotPosts(allPosts, 8);

// 仅在首页列表页（/ 与 /page/N/）显示
const isHomePage =
	Astro.url.pathname === "/" || /^\/page\/\d+\/?$/.test(Astro.url.pathname);
---

{
	isHomePage && (
		<WidgetLayout title="热门推荐" icon="fa-fire">
			{/* 固定静态标记保持旧版图标间距，避免 JSX 换行增加文字空格。 */}
			<a
				slot="actions"
				class="widget-more-link"
				href="/hot/"
				title="查看热门推荐"
			>
				<Fragment
					set:html={
						'<i class="fa fa-fire" aria-hidden="true"></i><span>更多详情</span>'
					}
				/>
			</a>
			<ul id="hotlog">
				{hotPosts.map((post, index) => (
					<li>
						<em
							class={
								index === 0
									? "hotone"
									: index === 1
										? "hottwo"
										: index === 2
											? "hotthree"
											: "hotSoSo"
							}
						>
							{index + 1}
						</em>
						<a href={`/posts/${post.id}/`} title={post.data.title}>
							{post.data.title}
						</a>
					</li>
				))}
			</ul>
		</WidgetLayout>
	)
}
