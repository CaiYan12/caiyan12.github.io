---
import WidgetLayout from "./WidgetLayout.astro";
import { getCollection } from "astro:content";
import { getNewPosts } from "../../utils/content-utils";
import dayjs from "dayjs";

const allPosts = await getCollection("posts");
const newPosts = getNewPosts(allPosts, 8);
---

<WidgetLayout title="最新文章" icon="fa-file-text-o">
	<ul id="newlog">
		{newPosts.map((post) => (
			<li>
				<i class="fa fa-angle-right" aria-hidden="true"></i>
				<a href={`/posts/${post.id}/`} title={post.data.title}>
					{post.data.title}
				</a>
				<span>{dayjs(post.data.published).format("MM-DD")}</span>
			</li>
		))}
	</ul>
</WidgetLayout>
