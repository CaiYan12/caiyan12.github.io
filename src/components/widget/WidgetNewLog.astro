---
import { getCollection } from "astro:content";
import { getNewPosts, isPublicPost } from "../../utils/content-utils";
import { shuffleArray } from "../../utils/shuffle";
import dayjs from "dayjs";

const allPosts = (await getCollection("posts")).filter(isPublicPost);
const newPosts = getNewPosts(allPosts, 8);
const surprisePosts = shuffleArray(allPosts).slice(0, 8);
const panels = [
	{ id: "newlog", posts: newPosts },
	{ id: "randlog", posts: surprisePosts.slice(0, 8) },
];
---

<div class="widget tab-widget" data-tab-widget>
	<div class="tab_nav">
		<ul role="tablist" aria-label="文章推荐">
			<li
				class="hover"
				role="tab"
				tabindex="0"
				aria-selected="true"
				data-tab="0"
			>
				<i class="fa fa-paint-brush" aria-hidden="true"></i>最新
			</li>
			<li role="tab" tabindex="0" aria-selected="false" data-tab="1">
				<i class="fa fa-random" aria-hidden="true"></i>手气不错
			</li>
		</ul>
		<div class="clear"></div>
	</div>
	<div class="tab_box">
		{
			panels.map((panel, panelIndex) => (
				<div
					class:list={[panelIndex !== 0 && "tab-panel-hidden"]}
					data-panel={panelIndex}
				>
					<ul id={panel.id}>
						{panel.posts.map((post) => (
							<li>
								<i
									class="fa fa-angle-right"
									aria-hidden="true"
								/>
								<a
									href={`/posts/${post.id}/`}
									title={post.data.title}
								>
									{post.data.title}
								</a>
								<span>
									{dayjs(post.data.published).format("MM-DD")}
								</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</div>
