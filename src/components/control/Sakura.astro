---
import { sakuraConfig } from "../../config";
---

{sakuraConfig.enable && (
	<canvas id="sakura-canvas" aria-hidden="true"></canvas>
)}

<script>
	import { sakuraConfig } from "../../config";

	const canvas = document.getElementById("sakura-canvas") as HTMLCanvasElement | null;

	if (canvas && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const context = canvas.getContext("2d");
		const image = new Image();
		let width = window.innerWidth;
		let height = window.innerHeight;
		let frameId = 0;
		let running = true;

		class Petal {
			x = Math.random() * width;
			y = Math.random() * height;
			scale = sakuraConfig.size.min + Math.random() * (sakuraConfig.size.max - sakuraConfig.size.min);
			alpha = sakuraConfig.opacity.min + Math.random() * (sakuraConfig.opacity.max - sakuraConfig.opacity.min);
			rotation = Math.random() * Math.PI * 2;
			velocityX = sakuraConfig.speed.horizontal.min + Math.random() * (sakuraConfig.speed.horizontal.max - sakuraConfig.speed.horizontal.min);
			velocityY = sakuraConfig.speed.vertical.min + Math.random() * (sakuraConfig.speed.vertical.max - sakuraConfig.speed.vertical.min);

			reset() {
				this.x = Math.random() > 0.4 ? Math.random() * width : width + 24;
				this.y = Math.random() > 0.4 ? -24 : Math.random() * height;
				this.alpha = sakuraConfig.opacity.min + Math.random() * (sakuraConfig.opacity.max - sakuraConfig.opacity.min);
			}

			update() {
				this.x += this.velocityX;
				this.y += this.velocityY;
				this.rotation += sakuraConfig.speed.rotation;
				this.alpha -= sakuraConfig.speed.fadeSpeed * 0.001;
				if (this.x < -48 || this.y > height + 48 || this.alpha <= 0) this.reset();
			}

			draw() {
				if (!context) return;
				context.save();
				context.translate(this.x, this.y);
				context.rotate(this.rotation);
				context.globalAlpha = this.alpha;
				context.drawImage(image, -20 * this.scale, -20 * this.scale, 40 * this.scale, 40 * this.scale);
				context.restore();
			}
		}

		const petals = Array.from({ length: sakuraConfig.sakuraNum }, () => new Petal());

		const resize = () => {
			width = window.innerWidth;
			height = window.innerHeight;
			const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
			canvas.width = Math.round(width * ratio);
			canvas.height = Math.round(height * ratio);
			context?.setTransform(ratio, 0, 0, ratio, 0, 0);
		};

		const render = () => {
			if (!context || !running) return;
			context.clearRect(0, 0, width, height);
			for (const petal of petals) {
				petal.update();
				petal.draw();
			}
			frameId = requestAnimationFrame(render);
		};

		const handleVisibility = () => {
			running = !document.hidden;
			if (running) render();
			else cancelAnimationFrame(frameId);
		};

		resize();
		image.addEventListener("load", render, { once: true });
		image.src = "/sakura.png";
		window.addEventListener("resize", resize, { passive: true });
		document.addEventListener("visibilitychange", handleVisibility);
	}
</script>

