---
import { commentConfig } from "../../config";

interface Props {
	/** 页面唯一标识（默认用当前路径） */
	term?: string;
}

const { term } = Astro.props;
const pageTerm = term ?? Astro.url.pathname;
const pageMapping = term ? "specific" : commentConfig.mapping;
---

{
	commentConfig.enable ? (
		<section id="comments" class="giscus-wrap">
			<h3>
				<i class="fa fa-comments-o" aria-hidden="true" /> 评论区
			</h3>
			<script
				is:inline
				id="giscus-src"
				src="https://giscus.app/client.js"
				data-repo={commentConfig.repo}
				data-repo-id={commentConfig.repoId}
				data-category={commentConfig.category}
				data-category-id={commentConfig.categoryId}
				data-mapping={pageMapping}
				data-strict="0"
				data-reactions-enabled={commentConfig.reactionsEnabled}
				data-emit-metadata={commentConfig.emitMetadata}
				data-input-position={commentConfig.inputPosition}
				data-theme={commentConfig.theme}
				data-lang={commentConfig.lang}
				data-loading="lazy"
				crossorigin="anonymous"
				async
				{...{ "data-term": pageTerm }}
			/>
			<div id="giscus-fallback" class="giscus-fallback" hidden>
				<p>
					<i class="fa fa-exclamation-circle" aria-hidden="true" />
					评论加载失败：可能无法访问 giscus.app，请检查网络后重试。
				</p>
				<button type="button" id="giscus-retry">
					重试加载
				</button>
			</div>
		</section>
	) : (
		<section id="comments">
			<h3>
				<i class="fa fa-comments-o" aria-hidden="true" /> 评论区
			</h3>
			<p class="nop">
				<i class="fa fa-commenting-o" aria-hidden="true" />
				评论功能暂未开放，欢迎稍后再来。
			</p>
		</section>
	)
}

{
	/* watcher 必须留在三元表达式之外：带内容的内联脚本位于表达式容器内时
    prettier-plugin-astro 的脚本解析会失败；评论区未启用时脚本开头的
    giscus-src 自检会直接退出，无需条件渲染 */
}
<script is:inline>
	(() => {
		const section = document.getElementById("comments");
		if (!section || section.dataset.giscusWatch === "1") return;
		if (!document.getElementById("giscus-src")) return;
		section.dataset.giscusWatch = "1";
		// data-loading="lazy" 下 giscus 只在滚动进入视口才建 iframe：
		// 先等 IntersectionObserver 确认用户看过评论区，超时后仍无
		// iframe 才判失败，避免未滚到的页面误报
		const GISCUS_TIMEOUT_MS = 8000;
		const fallback = document.getElementById("giscus-fallback");
		if (!fallback) return;
		let seen = false;
		let timer;
		const io = new IntersectionObserver((entries) => {
			if (entries.some((entry) => entry.isIntersecting)) {
				seen = true;
				io.disconnect();
			}
		});
		io.observe(section);
		const check = () => {
			if (!seen) return;
			if (document.querySelector(".giscus-frame")) return;
			fallback.hidden = false;
		};
		const arm = () => {
			timer = setTimeout(check, GISCUS_TIMEOUT_MS);
		};
		const retry = () => {
			clearTimeout(timer);
			document
				.querySelectorAll(".giscus-frame")
				.forEach((frame) => frame.remove());
			// 以原脚本属性重建脚本元素（cloneNode 不会重新执行）
			const template = document.getElementById("giscus-src");
			if (template) {
				const fresh = document.createElement("script");
				for (const attr of template.attributes) {
					fresh.setAttribute(attr.name, attr.value);
				}
				template.replaceWith(fresh);
			}
			fallback.hidden = true;
			arm();
		};
		document
			.getElementById("giscus-retry")
			?.addEventListener("click", retry);
		arm();
	})();
</script>
