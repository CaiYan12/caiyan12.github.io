---
import { siteConfig, footerConfig } from "../../config";

const startYear = new Date(siteConfig.foundationTime).getFullYear();
const currentYear = new Date().getFullYear();
// 构建期直接计算运行天数（客户端脚本因执行时序读不到 window.__siteData）
const totalDays = Math.max(
	1,
	Math.floor(
		(Date.now() - new Date(siteConfig.foundationTime).getTime()) / 86400000,
	),
);
---

<footer id="footer" class="site-footer" role="contentinfo">
	<address class="not-italic">
		<i class="fa fa-html5" aria-hidden="true"></i>
		Copyright&nbsp;©&nbsp;{startYear}-{currentYear}&nbsp;{siteConfig.title}
		<div class="copyright">
			&nbsp;|&nbsp;勉强运行：<span id="runtime-days">{totalDays}</span>天&nbsp;|&nbsp;
			{siteConfig.icp && (
				<>
					<a href="http://www.miibeian.gov.cn" target="_blank">
						{siteConfig.icp}
					</a>
					&nbsp;|&nbsp;
				</>
			)}
			{siteConfig.footerInfo}
			{footerConfig.showEmlogCredit && (
				<>
					&nbsp;|&nbsp;自豪的采用 Astro&nbsp;驱动&nbsp;|&nbsp;主题移植自
					<a href="http://limh.me" title="明月浩空" target="_blank">
						Colorful
					</a>
				</>
			)}
		</div>
	</address>
</footer>
