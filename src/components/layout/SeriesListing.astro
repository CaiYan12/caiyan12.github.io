---
/**
 * 单文集页列表体（第 1 页与 page/N 分页变体共用同一渲染）。
 * 只引用 ListingHeader（页头）/ PostCard（成员卡）/ Pagination（分页）/ ResponsiveImage（封面）四个既有组件——
 * 文集页要的是成员清单而不是药丸云，故不像标签页/分类页那样渲染 TagPillCloud。
 * 数据获取（getStaticPaths / paginate）由各页面文件负责。
 */
import ListingHeader from "./ListingHeader.astro";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";
import ResponsiveImage from "../control/ResponsiveImage.astro";
import type { Post } from "../../utils/content-utils";
import { getLqipProps } from "../../utils/lqip-utils";
import { getPaginationUrl } from "../../utils/pagination";

interface Props {
	name: string;
	/** 量词（章 / 篇），用于计数行「共 N 章」 */
	unit: string;
	/** 当前文集下的成员总数（post-context 统计行口径） */
	totalCount: number;
	/** 当前页成员（第 1 页为手写切片，分页变体来自 Astro paginate），已按 seriesOrder 升序 */
	posts: Post[];
	current: number;
	total: number;
	rootUrl: string;
	/** 文集封面（显式 cover 或首位带 image 的成员头图）；null 时不渲染顶部横幅 */
	cover?: string | null;
}

const { name, unit, totalCount, posts, current, total, rootUrl, cover } =
	Astro.props;
---

<div class="page series-page">
	{
		cover && (
			/* 顶部封面：插在 ListingHeader 之前，与文章页「图 → 标题」同序；
			   复用文章页 .page .post-cover 范式（260px 横幅 + 底缘渐隐 + object-fit: cover），
			   零新 CSS——目录页容器本就是 .page，选择器直接命中，窄屏无媒体查询覆盖仍为 260px */
			<figure class="post-cover lqip-wrap">
				<div
					class="lqip-placeholder"
					style={getLqipProps(cover).style}
					aria-hidden="true"
				/>
				<ResponsiveImage
					src={cover}
					alt={name}
					title={name}
					loading="eager"
					sizes="(max-width: 680px) 100vw, (max-width: 1000px) calc(100vw - 40px), 660px"
				/>
			</figure>
		)
	}
	<ListingHeader
		icon="fa-book"
		title={name}
		crumbs={[
			{ label: "文章文集", href: "/series/" },
			{ label: name, icon: "fa-book" },
		]}
	/>

	<div class="post-context">
		<p>共 {totalCount} {unit}</p>
	</div>
</div>

{posts.map((post) => <PostCard post={post} />)}

<Pagination
	current={current}
	total={total}
	urlTemplate={getPaginationUrl(rootUrl, "{n}")}
	firstPageUrl={rootUrl}
/>
