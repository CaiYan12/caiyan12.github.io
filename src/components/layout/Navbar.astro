---
import { navBarConfig, siteConfig } from "../../config";
import { diary } from "../../data/diary";
import dayjs from "dayjs";

const pathname = Astro.url.pathname;
const tickerItems = diary.slice(0, 4);

const isCurrent = (url: string) =>
	pathname === url ||
	(url !== "/" && pathname.startsWith(url.replace(/\/$/, "")));
---

<!-- 移动端顶栏（对应原主题 #header1） -->
<header id="header1">
	<button
		id="open-nav"
		class="open-nav"
		type="button"
		aria-label="打开导航菜单"
		aria-expanded="false"
		aria-controls="mmenu"
	>
		<i class="fa fa-list-ul" aria-hidden="true"></i>
	</button>
	<div class="logo1">
		<h1>
			<a href="/" title="网站首页" class="logo1-text">
				{siteConfig.title}
			</a>
		</h1>
	</div>
</header>

<!-- 桌面头部（结构与 header.php 一致） -->
<header id="header" class="site-header">
	<div class="box">
		<div class="logo">
			<a href="/domain/" title="打开个人导航" data-no-swup>
				<img src={siteConfig.desktopLogo} alt={siteConfig.title} />
			</a>
		</div>
		<h1>
			<a href="/" title="网站首页">{siteConfig.title}</a>
		</h1>
		{
			tickerItems.length > 0 && (
				<div class="text" aria-label="最新微言">
					<ul>
						{tickerItems.map((item) => (
							<li>
								<a title="查看更多微言碎语" href="/diary/">
									{dayjs(item.date).format("YYYY年M月D日")} -{" "}
									{item.content}
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
	</div>
</header>

<!-- 导航栏（对应原主题 #head-nav） -->
<nav id="head-nav" class="head-nav" aria-label="主导航">
	<div class="head-nav-wrap clearfix" id="nav">
		<ul id="menu-index" class="nav">
			{
				navBarConfig.items.map((item) => (
					<li
						class:list={[
							"common",
							{ current: isCurrent(item.url) },
						]}
					>
						<a
							href={item.url}
							aria-current={
								isCurrent(item.url) ? "page" : undefined
							}
						>
							{item.name}
						</a>
					</li>
				))
			}

			{
				navBarConfig.archiveSite.length > 0 && (
					<li
						class:list={[
							"dropdown",
							{
								current: navBarConfig.archiveSite.some((item) =>
									isCurrent(item.url),
								),
							},
						]}
					>
						<a class="catbtns" href="javascript:void(0)">
							文章归档
							<i class="arrow" />
						</a>
						<ul>
							{navBarConfig.archiveSite.map((item) => (
								<li>
									<a href={item.url}>{item.name}</a>
								</li>
							))}
						</ul>
					</li>
				)
			}

			{
				navBarConfig.aboutSite.length > 0 && (
					<li
						class:list={[
							"dropdown",
							{
								current: navBarConfig.aboutSite.some((item) =>
									isCurrent(item.url),
								),
							},
						]}
					>
						<a class="catbtns" href="javascript:void(0)">
							关于本站
							<i class="arrow" />
						</a>
						<ul>
							{navBarConfig.aboutSite.map((item) => (
								<li>
									<a href={item.url}>{item.name}</a>
								</li>
							))}
						</ul>
					</li>
				)
			}

			{
				navBarConfig.extra.length > 0 && (
					<li class="dropdown">
						<a class="catbtns" href="javascript:void(0)">
							附加功能
							<i class="arrow" />
						</a>
						<ul>
							{navBarConfig.extra.map((item) => (
								<li>
									<a href={item.url}>{item.name}</a>
								</li>
							))}
						</ul>
					</li>
				)
			}

			{
				navBarConfig.resourceSite.length > 0 && (
					<li
						class:list={[
							"dropdown",
							{
								current: navBarConfig.resourceSite.some(
									(item) => isCurrent(item.url),
								),
							},
						]}
					>
						<a class="catbtns" href="javascript:void(0)">
							本站资源
							<i class="arrow" />
						</a>
						<ul>
							{navBarConfig.resourceSite.map((item) => (
								<li>
									<a
										href={item.url}
										data-no-swup={
											item.noSwup ? "" : undefined
										}
									>
										{item.name}
									</a>
								</li>
							))}
						</ul>
					</li>
				)
			}
		</ul>

		<ul class="m-nav">
			{
				navBarConfig.social.bilibili.show && (
					<li>
						<a
							class="bilibili"
							rel="nofollow"
							title={`哔哩哔哩：${navBarConfig.social.bilibili.id}`}
							href={navBarConfig.social.bilibili.url}
							target="_blank"
						>
							{/* FA4 无 bilibili 字形，内联 Simple Icons 官方路径 */}
							<svg
								class="bilibili-icon"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z" />
							</svg>
							B站
						</a>
					</li>
				)
			}
			{
				navBarConfig.social.qq.show && (
					<li>
						<a
							class="qq qrcode"
							rel="nofollow"
							title={`QQ：${navBarConfig.social.qq.id}（点击复制）`}
							href={navBarConfig.social.qq.image}
							target="_blank"
							data-copy-link={navBarConfig.social.qq.id}
							data-copy-message="已复制QQ号"
						>
							<i class="fa fa-qq" /> QQ
							<span class="qrcode-pop">
								<span class="qrcode-frame">
									<img
										src={navBarConfig.social.qq.image}
										alt="QQ 二维码"
										loading="lazy"
									/>
								</span>
							</span>
						</a>
					</li>
				)
			}
			{
				navBarConfig.social.wechat.show && (
					<li>
						<a
							class="wechat qrcode"
							title="微信：悬浮查看二维码"
							href="javascript:void(0)"
						>
							<i class="fa fa-wechat" /> 微信
							<span class="qrcode-pop">
								<span class="qrcode-frame">
									<img
										src={navBarConfig.social.wechat.image}
										alt="微信二维码"
										loading="lazy"
									/>
								</span>
							</span>
						</a>
					</li>
				)
			}
			{
				navBarConfig.social.rss.show && (
					<li class="m-sch">
						<a
							class="rss"
							rel="nofollow"
							title="RSS订阅（点击复制）"
							href={navBarConfig.social.rss.url}
							target="_blank"
							data-copy-link={`${siteConfig.siteURL}${navBarConfig.social.rss.url}`}
							data-copy-message="已复制订阅链接"
						>
							<i class="fa fa-rss" /> 订阅
						</a>
					</li>
				)
			}
		</ul>
	</div>
</nav>
