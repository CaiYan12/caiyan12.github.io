---
import { navBarConfig, siteConfig } from "../../config";
import { getCollection } from "astro:content";
import { getCategoryList } from "../../utils/content-utils";

const allPosts = await getCollection("posts");
const categories = getCategoryList(allPosts);
const pathname = Astro.url.pathname;

const isCurrent = (url: string) =>
	pathname === url ||
	(url !== "/" && pathname.startsWith(url.replace(/\/$/, "")));
---

<!-- 移动端顶栏（对应 header1） -->
<header id="header1" class="md:hidden bg-white border-b border-line">
	<div class="flex items-center justify-between px-3 py-2">
		<div id="open-nav" class="open-nav !mx-0 !my-0">
			<i class="fa fa-list-ul" aria-hidden="true"></i>
		</div>
		<div class="logo1">
			<a href="/" title="网站首页">
				<img
					src={siteConfig.avatar}
					alt={siteConfig.title}
					class="h-10 w-auto"
				/>
			</a>
		</div>
	</div>
</header>

<!-- 桌面头部（对应 header） -->
<header id="header" class="site-header">
	<div class="flex flex-wrap items-center justify-between">
		<div class="flex items-center">
			<div class="logo">
				<a href="/" title={siteConfig.title}>
					<img src={siteConfig.avatar} alt={siteConfig.title} class="h-12 w-auto" />
				</a>
			</div>
			<h1>
				<a href="/" title="网站首页">{siteConfig.title}</a>
			</h1>
		</div>
	</div>
</header>

<!-- 导航栏（对应 head-nav） -->
<nav id="head-nav" class="head-nav hidden md:block" aria-label="主导航">
	<div class="head-nav-wrap clearfix">
		<ul id="menu-index" class="nav">
			{navBarConfig.items.map((item) => (
				<li class:list={["common", { current: isCurrent(item.url) }]}>
					<a href={item.url}>{item.name}</a>
				</li>
			))}

			{/* 附加功能下拉 */}
			{navBarConfig.extra.length > 0 && (
				<li class="dropdown">
					<a class="catbtns" href="javascript:void(0)">
						附加功能<i class="arrow"></i>
					</a>
					<ul>
						{navBarConfig.extra.map((item) => (
							<li>
								<a href={item.url}>{item.name}</a>
							</li>
						))}
					</ul>
				</li>
			)}

			{/* 文章分类下拉 */}
			{navBarConfig.showCategoryDropdown && categories.length > 0 && (
				<li class="dropdown">
					<a class="catbtns" href="javascript:void(0)">
						文章分类<i class="arrow"></i>
					</a>
					<ul>
						{categories.map((cat) => (
							<li>
								<a href={`/category/${encodeURIComponent(cat.name)}/`}>
									{cat.name}
								</a>
							</li>
						))}
					</ul>
				</li>
			)}
		</ul>

		<ul class="m-nav">
			{navBarConfig.social.weibo.show && (
				<li>
					<a
						rel="nofollow"
						title={`新浪微博：@${navBarConfig.social.weibo.id}`}
						href={navBarConfig.social.weibo.url}
						target="_blank"
					>
						<i class="fa fa-weibo"></i> 微博
					</a>
				</li>
			)}
			{navBarConfig.social.qq.show && (
				<li>
					<a
						rel="nofollow"
						title={`QQ：${navBarConfig.social.qq.id}`}
						href={`http://wpa.qq.com/msgrd?v=3&uin=${navBarConfig.social.qq.id}&site=qq&menu=yes`}
						target="_blank"
					>
						<i class="fa fa-qq"></i> QQ
					</a>
				</li>
			)}
			{navBarConfig.social.wechat.show && (
				<li>
					<a
						class="wechat"
						rel="nofollow"
						title="点击查看微信二维码"
						href={navBarConfig.social.wechat.image}
						target="_blank"
					>
						<i class="fa fa-wechat"></i> 微信
					</a>
				</li>
			)}
			{navBarConfig.social.rss.show && (
				<li class="m-sch">
					<a
						class="rss"
						rel="nofollow"
						title="RSS订阅"
						href={navBarConfig.social.rss.url}
						target="_blank"
					>
						<i class="fa fa-rss"></i> 订阅
					</a>
				</li>
			)}
		</ul>
	</div>
</nav>
