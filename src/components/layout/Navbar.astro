---
import { navBarConfig, siteConfig } from "../../config";
import { diary } from "../../data/diary";
import dayjs from "dayjs";

const pathname = Astro.url.pathname;
const tickerItems = diary.slice(0, 4);

const isCurrent = (url: string) =>
	pathname === url ||
	(url !== "/" && pathname.startsWith(url.replace(/\/$/, "")));
---

<!-- 移动端顶栏（对应原主题 #header1） -->
<header id="header1">
	<button id="open-nav" class="open-nav" type="button" aria-label="打开导航菜单">
		<i class="fa fa-list-ul" aria-hidden="true"></i>
	</button>
	<div class="logo1">
		<h1>
			<a href="/" title="网站首页" class="logo1-text">
				{siteConfig.title}
			</a>
		</h1>
	</div>
</header>

<!-- 桌面头部（结构与 header.php 一致） -->
<header id="header" class="site-header">
	<div class="box">
		<div class="logo">
			<a href="/domain/" title="打开个人导航" data-no-swup>
				<img src={siteConfig.desktopLogo} alt={siteConfig.title} />
			</a>
		</div>
		<h1>
			<a href="/" title="网站首页">{siteConfig.title}</a>
		</h1>
		{tickerItems.length > 0 && (
			<div class="text" aria-label="最新微言">
				<ul>
					{tickerItems.map((item) => (
						<li>
							<a title="查看更多微言碎语" href="/diary/">
								{dayjs(item.date).format("YYYY年M月D日")} - {item.content}
							</a>
						</li>
					))}
					{tickerItems[0] && (
						<li aria-hidden="true">
							<a title="" href="/diary/" tabindex="-1">
								{dayjs(tickerItems[0].date).format("YYYY年M月D日")} - {tickerItems[0].content}
							</a>
						</li>
					)}
				</ul>
			</div>
		)}
	</div>
</header>

<!-- 导航栏（对应原主题 #head-nav） -->
<nav id="head-nav" class="head-nav" aria-label="主导航">
	<div class="head-nav-wrap clearfix" id="nav">
		<ul id="menu-index" class="nav">
			{navBarConfig.items.map((item) => (
				<li class:list={["common", { current: isCurrent(item.url) }]}>
					<a href={item.url}>{item.name}</a>
				</li>
			))}

			{navBarConfig.aboutSite.length > 0 && (
				<li
					class:list={[
						"dropdown",
						{
							current: navBarConfig.aboutSite.some((item) => isCurrent(item.url)),
						},
					]}
				>
					<a class="catbtns" href="javascript:void(0)">
						关于本站<i class="arrow"></i>
					</a>
					<ul>
						{navBarConfig.aboutSite.map((item) => (
							<li><a href={item.url}>{item.name}</a></li>
						))}
					</ul>
				</li>
			)}

			{navBarConfig.extra.length > 0 && (
				<li class="dropdown">
					<a class="catbtns" href="javascript:void(0)">
						附加功能<i class="arrow"></i>
					</a>
					<ul>
						{navBarConfig.extra.map((item) => (
							<li><a href={item.url}>{item.name}</a></li>
						))}
					</ul>
				</li>
			)}

			{navBarConfig.resourceSite.length > 0 && (
				<li
					class:list={[
						"dropdown",
						{
							current: navBarConfig.resourceSite.some((item) => isCurrent(item.url)),
						},
					]}
				>
					<a class="catbtns" href="javascript:void(0)">
						本站资源<i class="arrow"></i>
					</a>
					<ul>
						{navBarConfig.resourceSite.map((item) => (
							<li>
								<a href={item.url} data-no-swup={item.noSwup ? "" : undefined}>{item.name}</a>
							</li>
						))}
					</ul>
				</li>
			)}

		</ul>

		<ul class="m-nav">
			{navBarConfig.social.weibo.show && (
				<li>
					<a rel="nofollow" title={`新浪微博：@${navBarConfig.social.weibo.id}`} href={navBarConfig.social.weibo.url} target="_blank">
						<i class="fa fa-weibo"></i> 微博
					</a>
				</li>
			)}
			{navBarConfig.social.qq.show && (
				<li>
					<a rel="nofollow" title={`QQ：${navBarConfig.social.qq.id}`} href={`http://wpa.qq.com/msgrd?v=3&uin=${navBarConfig.social.qq.id}&site=qq&menu=yes`} target="_blank">
						<i class="fa fa-qq"></i> QQ
					</a>
				</li>
			)}
			{navBarConfig.social.wechat.show && (
				<li>
					<a class="wechat" rel="nofollow" title="点击查看微信二维码" href={navBarConfig.social.wechat.image} target="_blank">
						<i class="fa fa-wechat"></i> 微信
					</a>
				</li>
			)}
			{navBarConfig.social.rss.show && (
				<li class="m-sch">
					<a class="rss" rel="nofollow" title="RSS订阅" href={navBarConfig.social.rss.url} target="_blank">
						<i class="fa fa-rss"></i> 订阅
					</a>
				</li>
			)}
		</ul>
	</div>
</nav>
