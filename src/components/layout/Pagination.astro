---
interface Props {
	/** 当前页码（1 起） */
	current: number;
	/** 总页数 */
	total: number;
	/** 分页 URL 模板：/page/{n}/（{n} 会被替换；第 1 页固定为 /） */
	urlTemplate: string;
}

const { current, total, urlTemplate } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? "/" : urlTemplate.replace("{n}", String(n)));

/** 生成页码序列：1 … 2 3 4 … 10 */
function pageList(): (number | "...")[] {
	if (total <= 7) {
		return Array.from({ length: total }, (_, i) => i + 1);
	}
	const pages: (number | "...")[] = [1];
	const start = Math.max(2, current - 1);
	const end = Math.min(total - 1, current + 1);
	if (start > 2) pages.push("...");
	for (let i = start; i <= end; i++) pages.push(i);
	if (end < total - 1) pages.push("...");
	pages.push(total);
	return pages;
}
---

{total > 1 && (
	<div class="pagenavi" role="navigation" aria-label="分页">
		{current > 1 && (
			<a href={pageUrl(current - 1)} title="上一页">
				<i class="fa fa-chevron-left" aria-hidden="true"></i>
			</a>
		)}
		{pageList().map((p) =>
			p === "..." ? (
				<span class="page-dots">…</span>
			) : p === current ? (
				<span aria-current="page">{p}</span>
			) : (
				<a href={pageUrl(p)}>{p}</a>
			),
		)}
		{current < total && (
			<a href={pageUrl(current + 1)} title="下一页">
				<i class="fa fa-chevron-right" aria-hidden="true"></i>
			</a>
		)}
	</div>
)}
