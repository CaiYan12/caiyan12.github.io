---
/**
 * 标签/分类药丸云：标签云集、分类云集、单标签页、单分类页与侧栏 WidgetTag
 * 五处共用的同一 DOM 结构。样式挂点是 **类** `.blogtags`（不是 id）：`id="blogtags"` 只由
 * 正文/云集页那一份发射（`dedupeId` 参数控制），侧栏 WidgetTag 那份不带——同一页面出现
 * 两个同名 id 时，锚点、getElementById 与辅助技术引用只会指到第一处（issue #47）。药丸 6 色轮换/is-current/×N 样式全部
 * 收敛在 global.css（含 .tag-count 与 is-current 的源顺序约束），此处零样式。
 *
 * 空白陷阱：Astro compressHTML 会剥除相邻表达式之间的空白，×N 前后的空格
 * 必须用 {" "} 字符串表达式显式输出（保持与原版一致的药丸宽度）；
 * &times; 实体必须留在标记文本中——写入字符串表达式会被转义为 &amp;times;。
 */
interface PillItem {
	name: string;
	count: number;
}

interface Props {
	items: PillItem[];
	/** 药丸链接前缀：tag → /tag/<name>/，category → /category/<name>/ */
	base: "tag" | "category";
	/** 当前标签/分类名：命中项加 is-current 品牌绿高亮 + aria-current */
	current?: string;
	/** 侧栏 WidgetTag 不展示 ×N 计数 */
	showCount?: boolean;
	/** 侧栏那份置 true：不发射 id，避免与正文云在同页撞出两个 #blogtags */
	dedupeId?: boolean;
}

const {
	items,
	base,
	current,
	showCount = true,
	dedupeId = false,
} = Astro.props;

const hrefFor = (name: string) => `/${base}/${encodeURIComponent(name)}/`;
---

<ul id={dedupeId ? undefined : "blogtags"} class="blogtags">
	<li class="tag-cloud-items">
		{
			items.map((item) => (
				<a
					href={hrefFor(item.name)}
					title={`${item.count}篇文章`}
					aria-current={current === item.name ? "page" : undefined}
					class:list={[{ "is-current": current === item.name }]}
				>
					{item.name}
					{showCount && (
						<span class="tag-count"> &times;{item.count} </span>
					)}
				</a>
			))
		}
	</li>
</ul>
