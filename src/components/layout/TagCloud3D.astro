---
/**
 * 3D 标签/分类云（svg3dtagcloud 试验组件）
 * 与 TagPillCloud 数据同构（{name, count}[]），供 /tag/ 与 /category/ 云集页
 * 调用；药丸云保留在页面中（当前项高亮 + prefers-reduced-motion 回退）。
 */
interface CloudItem {
	name: string;
	count: number;
}

interface Props {
	items: CloudItem[];
	/** 链接前缀：tag → /tag/<name>/，category → /category/<name>/ */
	base: "tag" | "category";
}

const { items, base } = Astro.props;

const children = items.map((item) => ({
	label: item.name,
	url: `/${base}/${encodeURIComponent(item.name)}/`,
	tooltip: `${item.count}篇文章`,
}));
---

<style>
	/* 3D 云卡片：透明底融入页面，仅保留细边框勾出云的区域；
	   内层 stage 不留 padding——库按 offsetWidth 计算 svg 宽度，padding 会溢出 */
	.tag3d-card {
		margin-bottom: 10px;
		border: 1px solid #eaeaea;
		background: transparent;
		padding: 8px 10px;
	}

	.tag3d-stage {
		width: 100%;
	}
</style>

<style is:global>
	/* 库运行时创建的 SVG 元素不带 Astro scoped 属性，规则统一放 is:global 块
	   （scoped 管线会把 :global 内属性选择器的引号转义坏，编译出
	   [opacity=\"1.0\"] 永不匹配——实测踩坑），用 .tag3d-stage 限定范围 */

	/* hover 动效（animate 规范）：高频场景 → 快而含蓄；只过渡 transform/opacity，
	   若用 all 会连库逐帧写的 x/y 也被缓动产生拖影；缓动复用项目 token 不另造 */
	/* 标签强调 = Hover effect + Scale：150ms ease-out，克制的 1.15 倍；
	   (hover:hover)+(pointer:fine) 门控，避免触屏点按触发假 hover 缩放 */
	@media (hover: hover) and (pointer: fine) {
		.tag3d-stage a text {
			transition: transform 0.15s var(--ease-out);
			transform-box: fill-box;
			transform-origin: center;
		}

		.tag3d-stage a:hover text {
			transform: scale(1.15);
		}
	}

	/* tooltip 上浮 = Fade in + Translate：显示时上移 2px、消失回落；显示/隐藏由
	   库写死的 opacity="1.0"/"0.0" 属性驱动（实码核实），属性变化可触发 CSS 过渡 */
	.tag3d-stage svg > text {
		transition:
			opacity 0.16s ease,
			transform 0.18s var(--ease-out);
		transform: translateY(3px);
	}

	.tag3d-stage svg > text[opacity="1.0"] {
		transform: translateY(-2px);
	}

	/* reduced motion：去位移（缩放/上浮），保留 tooltip opacity 淡入淡出辅助理解 */
	@media (prefers-reduced-motion: reduce) {
		.tag3d-stage a:hover text {
			transform: none;
		}

		.tag3d-stage svg > text {
			transform: none;
			transition: opacity 0.16s ease;
		}
	}
</style>

{
	items.length > 0 && (
		<div class="tag3d-card">
			<div class="tag3d-stage" data-tags={JSON.stringify(children)} />
		</div>
	)
}
