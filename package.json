{
	"name": "myblog",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"description": "WindowsIt's Music Club - Astro 静态博客（由 Emlog Colorful 主题迁移）",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"prepare": "node scripts/enable-hooks.mjs",
		"build": "pnpm test:projects && pnpm test:nice-books && pnpm test:site-stats && pnpm test:utils && pnpm test:contributions && pnpm test:friend-icons && pnpm test:lib && node scripts/validate-post-slugs.mjs && node scripts/fetch-friend-icons.mjs && node scripts/generate-lqips.mjs && node scripts/fetch-github-projects.mjs && node scripts/fetch-github-repos.mjs && node scripts/fetch-github-contributions.mjs && astro build && node scripts/verify-katex-classes.mjs && node scripts/inject-buddha-banner.mjs && pagefind --site dist",
		"smoke:ai-news": "node scripts/ai-news-smoke.mjs",
		"smoke:nice-books": "node scripts/nice-books-smoke.mjs",
		"test:fancybox": "node scripts/fancybox-smoke.mjs",
		"smoke:ui": "node scripts/ui-smoke.mjs",
		"smoke:wallpaper-pull": "node scripts/wallpaper-pull-smoke.mjs",
		"smoke:console": "node scripts/console-smoke.mjs",
		"test:console": "node --test scripts/console-smoke.test.mjs",
		"test:prettier-math": "node --test scripts/prettier-math.test.mjs",
		"test:article-toc-browser": "node --test scripts/article-toc-browser.test.mjs",
		"smoke:pelican": "node scripts/pelican-bike-smoke.mjs",
		"smoke:series": "node scripts/series-smoke.mjs",
		"smoke:skills": "node scripts/skills-smoke.mjs",
		"qa:weather-mainland": "node scripts/wttr-mainland-check.mjs",
		"build:weather-cities": "node scripts/build-weather-cities.mjs",
		"build:weather-bg": "node scripts/build-weather-bg.mjs",
		"build:favicon": "node scripts/build-favicon.mjs",
		"qa:nice-books-geometry": "node scripts/nice-books-geometry-qa.mjs",
		"audit:ledger": "node scripts/ledger-audit.mjs",
		"preview": "astro preview",
		"new-post": "node scripts/new-post.mjs",
		"lqips": "node scripts/generate-lqips.mjs",
		"fetch-projects": "node scripts/fetch-github-projects.mjs",
		"fetch-repos": "node scripts/fetch-github-repos.mjs",
		"test:projects": "node --test scripts/fetch-github-projects.test.mjs && node --import ./scripts/test-hooks.mjs --test \"src/utils/projects.test.ts\" \"src/data/projects.test.ts\"",
		"fetch-friend-icons": "node scripts/fetch-friend-icons.mjs",
		"test:friend-icons": "node --test scripts/fetch-friend-icons.test.mjs",
		"test:lib": "node --test \"scripts/lib/*.test.mjs\" \"src/plugins/*.test.mjs\"",
		"sync-site-stats": "node scripts/sync-site-stats.mjs",
		"test:site-stats": "node --test scripts/sync-site-stats.test.mjs scripts/site-stats-fixture.test.mjs",
		"test:weather": "node --test scripts/weather-service.test.mjs scripts/weather-codes.test.mjs scripts/weather-city-catalog.test.mjs scripts/domain-weather.test.mjs scripts/weather-rules.test.mjs",
		"test:contributions": "node --test scripts/fetch-github-contributions.test.mjs",
		"test:utils": "node --import ./scripts/test-hooks.mjs --test \"src/utils/**/*.test.ts\"",
		"test:nice-books": "node --import ./scripts/test-hooks.mjs --test \"src/nice-books/**/*.test.ts\"",
		"astro": "astro",
		"format": "prettier --write ./src ./scripts ./docs ./*.md tailwind.config.cjs",
		"test:ai-news-ownership": "node scripts/ai-news-ownership.test.mjs",
		"test:katex-classes": "node scripts/verify-katex-classes.mjs",
		"verify:live": "node scripts/verify-live.mjs",
		"verify:live:swup": "node scripts/verify-live-swup.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/rss": "^4.0.14",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.1.2",
		"@expressive-code/plugin-collapsible-sections": "0.44.3",
		"@expressive-code/plugin-line-numbers": "0.44.3",
		"@fancyapps/ui": "^6.1.15",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/libre-baskerville": "5.3.0",
		"@fontsource-variable/noto-sans-sc": "^5.3.0",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "4.3.4",
		"astro": "7.4.4",
		"astro-expressive-code": "0.44.3",
		"autoprefixer": "10.6.2",
		"dayjs": "^1.11.23",
		"gsap": "3.15.0",
		"hastscript": "^9.0.1",
		"katex": "0.19.1",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "12.2.0",
		"pagefind": "1.6.0",
		"parse5": "^7.3.0",
		"qrcode": "^1.5.4",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-cjk-friendly": "^2.3.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.26.0",
		"sharp": "^0.35.5",
		"svelte": "5.57.3",
		"tailwindcss": "4.3.4",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "7.3.5",
		"@astrojs/ts-plugin": "^1.10.12",
		"@types/node": "^24.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.2.18",
		"playwright": "1.62.1",
		"postcss-nesting": "13.0.2",
		"prettier": "3.9.8",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1"
	},
	"packageManager": "pnpm@10.26.2",
	"pnpm": {
		"overrides": {
			"katex": "0.19.1"
		}
	}
}
